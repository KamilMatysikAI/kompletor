{
  "name": "kompletor",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "next start -p 3100",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run --mode unit",
    "test:integration": "vitest run --mode integration --no-file-parallelism",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:integration",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait db",
    "db:down": "docker compose -f docker-compose.dev.yml stop db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "import:katalog": "tsx scripts/import-katalogu.ts",
    "przelicz:zamowienia": "tsx scripts/przelicz-zamowienia.ts",
    "przeprowadzka": "tsx scripts/przeprowadzka.ts",
    "maile:podglady": "tsx lib/maile/podglady/generuj.ts",
    "org:seed": "tsx scripts/org.ts seed",
    "org:create": "tsx scripts/org.ts create",
    "org:list": "tsx scripts/org.ts list",
    "org:automaty": "tsx scripts/org.ts automaty",
    "zdjecia:do-bazy": "tsx scripts/org.ts zdjecia-do-bazy",
    "rola:aplikacji": "tsx scripts/org.ts rola-aplikacji",
    "sekret": "tsx scripts/sekret.ts",
    "klienci": "tsx scripts/klienci.ts",
    "konto": "tsx scripts/konto-kanalu.ts",
    "uzytkownik": "tsx scripts/uzytkownik.ts",
    "demo:panel": "tsx scripts/demo-panel.ts",
    "smoke:panel": "tsx scripts/smoke-panel.ts",
    "postinstall": "prisma generate",
    "wydruki:przyklady": "tsx scripts/wydruki-przyklady.ts",
    "cien": "tsx scripts/cien.ts",
    "ksef": "tsx scripts/ksef.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bwip-js": "4.11.4",
    "dotenv": "17.4.2",
    "imapflow": "2.11.0",
    "marked": "18.1.3",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "pdfjs-dist": "6.4.299",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
}
