// logistyka — schemat bazy.
// Źródło modelu: specyfikacja modelu stanów v1.4, rozdz. 2 i 8.
// katalog, lustro stanu (tylko INITIAL_IMPORT), oferty kanałów, kopie danych BL/wFirmy, importy, kolejka workera.
// (niżej): zamówienia, rezerwacje, kolejka „brakuje”, ruchy niepotwierdzone, outbox propagacji, konfiguracja okresów.
// wiele firm w jednej bazie. Każda tabela danych ma `organizationId`; izolację wymusza Postgres (RLS,
// migracja 00000000000000_baza): klient aplikacji łączy się jako rola `logistyka_app` z ustawieniem sesji
// `app.org_id` = id firmy (lib/db.ts) i widzi wyłącznie jej wiersze; domyślna wartość `organizationId` pochodzi
// z tego samego ustawienia, więc zapis bez organizacji jest niemożliwy. Unikalności są złożone z `organizationId`.
// Nazwy tabel po angielsku (konwencja system-najmu), opisy po polsku. Ilości w jednostce bazowej (szt. albo g).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Słowniki ────────────────────────────────────────────────────────────────

enum ProductKind {
  STOCKED // towar albo komplet wFirmy z własnym stanem
  BUNDLE // zestaw wirtualny (tylko u nas), rezerwuje składniki
  // bez stanu (e-book, usługa): nie rezerwuje, nie trafia do „brakuje” ani na kanały, na fakturze jako usługa
  DIGITAL
}

// skąd pochodzą dane produktu. WFIRMA = towar wFirmy (nazwa księgowa, ceny, VAT tylko do odczytu w panelu),
// BL = kopia z BaseLinkera (import, przeprowadzka), KANAL = założony z oferty sklepu, CSV = import pliku (później),
// RECZNE = założony w panelu. Przy RECZNE/KANAL/CSV wszystkie pola edytowalne w karcie produktu.
enum ProductDataSource {
  RECZNE
  KANAL
  CSV
  BL
  WFIRMA
}

enum Unit {
  SZT
  KG // ilości w gramach
}

// Typ kanału. Konkretny sklep/konto rozróżnia `channelAccountId` (konfiguracja firmy w ChannelConfig).
enum Channel {
  WOO
  ALLEGRO
  EMPIK
  EASYTOOLS
  BL_INNE // InPost Buy, TikTok i inne źródła obsługiwane jeszcze przez BL
  RECZNE
  AI // dostawca AI jako zwykła integracja (adapterKey np. „ai.anthropic.v1”, model i limity w config); nie kanał sprzedaży
  SHOPER
  PRESTASHOP
  IDOSELL
}

enum ChannelMode {
  CIEN
  PRACA
}

enum MappingState {
  MAPPED // dokładnie jeden produkt BL
  UNMAPPED // brak powiązania z magazynem
  AMBIGUOUS // więcej niż jeden produkt BL
}

enum MappingSource {
  BL_LINK // links w getInventoryProductsData (sklepy Woo)
  BL_ORDERS // pozycje zamówień BL (Allegro, Empik, inne)
  SKU // dopasowanie po SKU (Empik shop_sku; Woo bez linku BL — tylko propozycja do zatwierdzenia)
  OVERRIDE // tabela nadpisań w repo (dane/nadpisania-ofert/<firma>.csv): oferta powiązana w BL po fakcie
  MANUAL // powiązanie z panelu — import nie zmienia productId, active ani qtyBasePerOffer
  CONFIG // reguła firmy (Organization.settings.catalog.noStock): oferta produktu bez stanu
  NONE
}

enum MovementSource {
  WFIRMA_SYNC
  OWN_INVOICE
  BL_INVOICE
  OWN_CORRECTION
  ISSUED_WITHOUT_DOCUMENT
  STOCK_MISSING
  INITIAL_IMPORT
  // wydanie z magazynu prowadzonego przez Kompletor (źródło stanu KOMPLETOR) przy „Do wysyłki / Do odbioru”
  OWN_DISPATCH
  // zwrot przyjęty na stan w magazynie prowadzonym przez Kompletor (bez korekty w programie do faktur)
  OWN_RETURN
}

// kto prowadzi stan fizyczny magazynu. WFIRMA = lustro magazynu wFirmy (rozchód fakturą z WZ, potwierdza
// odczyt wFirmy); KOMPLETOR = stan prowadzi Kompletor (rozchód przy wydaniu, korekta z panelu).
enum StockSource {
  KOMPLETOR
  WFIRMA
}

enum ImportStatus {
  RUNNING
  OK
  PARTIAL // część elementów z błędem (ImportIssue), reszta zapisana
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ─── Katalog (spec 2.1, 8) ───────────────────────────────────────────────────

model Product {
  organizationId    String            @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                String            @id @default(cuid())
  sku               String // SKU unikalne w firmie (przy towarze wFirmy = kod towaru w wFirmie)
  kind              ProductKind
  // źródło danych produktu (patrz enum); pola z WFIRMA są tylko do odczytu
  dataSource        ProductDataSource @default(RECZNE)
  unit              Unit
  groupId           String? // grupa wariantów (id produktu-rodzica w BL)
  // ceny, VAT, nazwa księgowa: przy dataSource WFIRMA z wFirmy (tylko odczyt), w pozostałych edytowalne w panelu
  wfirmaGoodId      String?
  wfirmaType        String?
  nameAccounting    String
  priceNet          Decimal?          @db.Decimal(12, 2) // good_prices[detaliczna].netto
  priceGross        Decimal?          @db.Decimal(12, 2)
  vatRate           String?
  purchasePriceNet  Decimal?          @db.Decimal(12, 4) // value / count
  wfirmaSyncedAt    DateTime?
  wfirmaHash        String?
  // własne
  ean               String?
  title             String
  description       String?
  details           Json?
  lowStockThreshold Int?
  // waga i wymiary do przesyłki (podpowiedź wagi paczki)
  weightG           Int?
  lengthCm          Decimal?          @db.Decimal(7, 1)
  widthCm           Decimal?          @db.Decimal(7, 1)
  heightCm          Decimal?          @db.Decimal(7, 1)
  // strefa magazynu ustawiona ręcznie w karcie produktu; null = z reguł firmy (ProductZoneRule).
  // klucz strefy firmy (PackingZoneDef.key), nie enum
  packingZone       String?
  // kategoria asortymentowa (jedna na produkt, drzewo firmy w ProductCategory); null = bez kategorii.
  // Źródło = informacja, skąd wzięło się bieżące przypisanie (RECZNE | CSV | KANAL | BL | USUNIECIE, lib/produkty/kategorie.ts);
  // nie blokuje zmiany: ręczne przypisanie, lista i import CSV nadpisują kategorię niezależnie od źródła.
  categoryId        String?
  categorySource    String?
  categorySetAt     DateTime?
  // klucz złożony z firmą: produkt nie wskaże kategorii innej firmy nawet z pominięciem kodu (jak Stock → Warehouse)
  category          ProductCategory?  @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  bundleComponents BundleComponent[] @relation("Bundle")
  usedInBundles    BundleComponent[] @relation("Component")
  stocks           Stock[]
  movements        StockMovement[]
  offers           ChannelOffer[]
  blProducts       BlProduct[]
  packDrillFixes   PackDrillFix[]
  images           ProductImage[]

  @@unique([organizationId, sku])
  @@unique([organizationId, wfirmaGoodId])
  @@index([ean])
  @@index([organizationId, categoryId])
}

// zdjęcia produktu. Pliki w katalogu zdjęć (ZDJECIA_DIR, wolumen kontenera): <firma>/<id>.webp (do 1600 px),
// <id>-m.webp (miniatura 160 px), <id>-p.jpg (do wydruku 96 px). Kolejność `position` rosnąco, pierwsze = główne.
// `sourceUrl` = zdjęcie pobrane z oferty sklepu (import), unikalne w produkcie, żeby kolejne pobranie go nie dublowało.
model ProductImage {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  productId      String
  position       Int
  width          Int
  height         Int
  bytes          Int
  sourceUrl      String?
  actorId        String
  createdAt      DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sourceUrl])
  @@index([productId, position])
}

/// bajty zdjęcia produktu w bazie (zamiast katalogu ZDJECIA_DIR), żeby panel i worker w osobnych kontenerach
/// widziały te same zdjęcia, a kopia bazy obejmowała zdjęcia. Jeden wiersz na zdjęcie: webp do 1600 px, miniatura
/// 160 px, JPEG do wydruku 96 px (wszystkie zapisane od nowa przez sharp). Bez klucza obcego do ProductImage: usunięte
/// zdjęcie zostaje tu jako archiwum (`archivedAt`), jak wcześniej pliki w `old/`, nic nie jest kasowane.
model ProductImageData {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  imageId        String       @id
  productId      String
  full           Bytes
  mini           Bytes
  druk           Bytes
  /// „panel” (wgrane w panelu albo pobrane z oferty) albo „dysk” (przeniesione z katalogu ZDJECIA_DIR)
  zrodlo         String       @default("panel")
  createdAt      DateTime     @default(now())
  archivedAt     DateTime?

  @@index([productId])
}

model BundleComponent {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bundleId       String
  componentId    String
  qtyBase        Int
  priceShare     Decimal?     @db.Decimal(6, 4)

  bundle    Product @relation("Bundle", fields: [bundleId], references: [id], onDelete: Cascade)
  component Product @relation("Component", fields: [componentId], references: [id], onDelete: Restrict)

  @@id([bundleId, componentId])
}

// ─── Stan: lustro wFirmy (spec 2.2). Zakłada tylko wiersz startowy. ─────

model Warehouse {
  organizationId    String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                String // np. „glowny”; unikalne w obrębie firmy
  name              String
  wfirmaWarehouseId String? // magazyn wFirmy, z którego idzie lustro stanu
  // źródło stanu; null = wywnioskowane z wfirmaWarehouseId (lib/rdzen/zrodlo-stanu.ts, zgodność wstecz)
  stockSource       StockSource?
  stocks            Stock[]

  @@id([organizationId, id])
  @@unique([organizationId, wfirmaWarehouseId])
}

model Stock {
  organizationId         String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId              String
  warehouseId            String
  wfirmaCount            Int
  wfirmaReadAt           DateTime
  pendingDelta           Int          @default(0)
  physical               Int
  reserved               Int          @default(0)
  overcommitSince        DateTime?
  overcommitListedAt     DateTime? // produkt na liście „Nadmiar rezerwacji” (4.4)
  allocationPendingSince DateTime?
  version                Int          @default(0)
  location               String? // miejsce na półce z BL (np. B-3-4) — sortowanie kart zbierania

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [organizationId, warehouseId], references: [organizationId, id])

  @@id([productId, warehouseId])
}

model StockMovement {
  organizationId String         @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String         @id @default(cuid())
  productId      String
  warehouseId    String
  deltaPhysical  Int
  source         MovementSource
  reason         String
  actorId        String
  orderId        String?
  createdAt      DateTime       @default(now())

  // Historia tylko dopisywana (spec 2.2): produkt wyłącza się przez active = false, nie kasuje.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

// ─── Kanały (spec 2.4, 2.5) ──────────────────────────────────────────────────

// wyzwalacze `ChannelOffer_rejestr_zmiana` i `ChannelOffer_rejestr_usuniecie` (migracja 20261109116700)
// kasują wpis `ChannelSyncState` przy zmianie active / productId / qtyBasePerOffer / externalId / konta i przy usunięciu
// oferty. Prisma ich nie widzi: odtworzenie tabeli albo zmiana klucza wymaga ponownego założenia wyzwalaczy (pilnuje
// tego test tests/rejestr-synchronizacji.integration.test.ts).
model ChannelOffer {
  organizationId        String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                    String        @id @default(cuid())
  channel               Channel
  channelAccountId      String
  externalId            String // Woo: "<productId>" albo "<productId>/<variantId>"; Allegro: id oferty; Empik: product_sku
  productId             String
  qtyBasePerOffer       Int           @default(1)
  safetyBuffer          Int?
  lastPushedQty         Int?
  lastPushedAt          DateTime?
  lastSeenQty           Int?
  active                Boolean       @default(true)
  mappingSource         MappingSource @default(NONE)
  // Propozycja importu (Woo po samym SKU, bez linku BL): nieaktywna do zatwierdzenia w panelu (F2).
  needsApproval         Boolean       @default(false)
  // Kiedy ofertę wyłączył import. Import włącza z powrotem tylko ofertę, którą sam wyłączył;
  // wyłączenie w panelu zostawia to pole puste i jest trwałe.
  deactivatedByImportAt DateTime?
  // kanał zakończył ofertę na polecenie Kompletora (stan 0); przy stanie dodatnim Kompletor wznawia tylko
  // taką ofertę. Pusta = nie my (zakończona ręcznie albo przez kanał zostaje zakończona).
  endedByZeroStockAt    DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([organizationId, channel, channelAccountId, externalId])
  @@index([productId])
}

model ChannelConfig {
  organizationId      String              @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel             Channel
  channelAccountId    String
  name                String
  stockMode           ChannelMode         @default(CIEN)
  statusMode          ChannelMode         @default(CIEN)
  trackingMode        ChannelMode         @default(CIEN)
  publishMode         ChannelMode         @default(CIEN)
  defaultSafetyBuffer Int                 @default(0)
  goBy                String?
  goAt                DateTime?
  goRef               String?
  // konfiguracja konta w bazie zamiast stałych w kodzie
  active              Boolean             @default(true)
  // Zgoda człowieka na masowe wyłączenie ofert przez import do tej chwili (bezpiecznik drobna 3)
  allowMassOffUntil   DateTime?
  blStorageId         String? // magazyn zewnętrzny sklepu w BL (np. „shop_1234567”): import ofert z BL
  // Adapter konta jako tekst (np. „woo.rest.v1”, „allegro.v1”): nowy adapter nie wymaga migracji rdzenia;
  // enum `channel` zostaje rodziną kanału dla logiki rdzenia (np. SELF_DECREMENTING). Porównanie z OpenLinkerem 25.10.
  adapterKey          String
  config              Json                @default("{}") // ustawienia konta dla adaptera (bez sekretów)
  updatedAt           DateTime            @updatedAt
  secrets             IntegrationSecret[]

  @@id([organizationId, channel, channelAccountId])
}

// ─── Kopie źródeł (tylko odczyt, bez danych osobowych) ───────────────────────

model BlProduct {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String // product_id z magazynu BL (unikalny w obrębie firmy)
  inventoryId      String
  parentId         String? // wariant: id produktu-rodzica
  sku              String?
  ean              String?
  name             String
  isBundle         Boolean      @default(false)
  bundleProducts   Json? // { blProductId: ilość }
  taxRate          Decimal?     @db.Decimal(5, 2)
  priceGross       Decimal?     @db.Decimal(12, 2) // domyślna grupa cen
  stockAccounting  Decimal?     @db.Decimal(14, 4) // magazyn accounting_1 (= wFirma)
  stockBl          Decimal?     @db.Decimal(14, 4)
  links            Json? // { "shop_1234567": {product_id, variant_id}, "accounting_1": {...} }
  wfirmaGoodIdLink String? // links.accounting_1.product_id
  locations        Json? // { "bl_<id magazynu>": "B-3-4" } z getInventoryProductsData
  productId        String? // nasz Product po imporcie
  importRunId      String
  importedAt       DateTime     @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@id([organizationId, id])
  @@index([sku])
  @@index([ean])
}

model WfirmaGood {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String
  code             String?
  name             String
  type             String // good | set | service
  unit             String
  vatCodeId        String?
  vatRate          String?
  priceNetRetail   Decimal?     @db.Decimal(12, 2)
  priceGrossRetail Decimal?     @db.Decimal(12, 2)
  purchasePriceNet Decimal?     @db.Decimal(12, 4)
  count            Decimal?     @db.Decimal(14, 4) // w jednostce wFirmy (szt. albo kg)
  warehouseId      String?
  ean              String?
  visibility       String?
  modified         String?
  importRunId      String
  importedAt       DateTime     @default(now())

  @@id([organizationId, id])
  @@index([code])
}

// Oferta/produkt kanału z wynikiem mapowania — też te bez powiązania (raport).
model ChannelOfferImport {
  organizationId   String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String        @id @default(cuid())
  channel          Channel
  channelAccountId String
  externalId       String
  sku              String?
  ean              String?
  name             String?
  state            MappingState
  source           MappingSource
  blProductIds     String[]
  productId        String?
  sales90dQty      Int           @default(0)
  sales90dOrders   Int           @default(0)
  lastSoldAt       DateTime?
  notes            String[]
  importRunId      String
  updatedAt        DateTime      @updatedAt

  @@unique([organizationId, channel, channelAccountId, externalId])
  @@index([state])
}

// ─── Importy i błędy per element ─────────────────────────────────────────────

model ImportRun {
  organizationId String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String        @id @default(cuid())
  kind           String
  status         ImportStatus  @default(RUNNING)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  stats          Json?
  error          String?
  /// raport Markdown przebiegu przeprowadzki z panelu (do pobrania z ekranu; bez danych klientów).
  reportMarkdown String?
  issues         ImportIssue[]
}

model ImportIssue {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  runId          String
  kind           String
  ref            String
  message        String
  createdAt      DateTime     @default(now())

  run ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ─── Kolejka zadań workera (Postgres, FOR UPDATE SKIP LOCKED) ────────────────

model Job {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  kind           String
  payload        Json?
  status         JobStatus    @default(PENDING)
  runAfter       DateTime     @default(now())
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  lastError      String?
  lockedAt       DateTime?
  lockedBy       String?
  dedupeKey      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([status, runAfter])
}

// ═══: rdzeń stanów i rezerwacji (spec 2.2–2.5, 3–6) ═══════════════

enum OrderStatus {
  NOWE
  DO_REALIZACJI
  ZBIERANIE
  ZEBRANE
  SPAKOWANE
  DO_WYSLANIA
  DO_ODBIORU
  WYSLANE
  ODEBRANE
  ANULOWANE
  DO_WYJASNIENIA
  REKLAMACJA
}

enum PaymentState {
  UNPAID
  PAID
  COD // pobranie: traktowane jak opłacone, rezerwacja nie wygasa
  PARTIAL // niedopłata: wygasa jak UNPAID, z flagą
}

enum Carrier {
  PACZKOMATY
  DPD
  DPD_EMPIK
  INPOST_KURIER // kurier InPost przez ShipX (paczkomat to PACZKOMATY)
  ORLEN_PACZKA // punkty i automaty Orlen Paczki (bez kuriera pod adres)
  GLS // GLS Polska (kurier i punkty ParcelShop)
  POCZTA_POLSKA // Pocztex Kurier pod adres przez eNadawcę
  ALLEGRO
  OSOBISTY
  BRAK
  // same pozycje bez stanu (e-book) na koncie w PRACA — bez zbierania i kuriera, po fakturze ODEBRANE
  BEZ_WYSYLKI
}

enum ShippingModule {
  BASE_COURIER
  WYSYLAM_Z_ALLEGRO
  INPOST_SHIPX
  DPD_BEZPOSREDNIO
  ORLEN_PACZKA
  GLS_ADE
  POCZTA_POLSKA
  BRAK
}

enum ReservationState {
  ACTIVE
  CONSUMING // faktura w drodze do wFirmy
  CONSUMED
  RELEASED
}

enum ShortageState {
  OPEN
  SHIP_LATER
  RESOLVED // dostała rezerwację (reservationId)
  REFUND_PENDING
  REFUNDED
  COD_REDUCED
  CANCELLED
}

// Decyzja obsługi o brakującej pozycji. WYSLIJ_RESZTE = domyślna: reszta wychodzi, za brak zwrot albo
// mniejsze pobranie (spec 4.2); DOSLIJ = druga paczka; POCZEKAJ = nie pakować do dostawy; ZAMIEN = inny produkt.
enum ShortageAction {
  WYSLIJ_RESZTE
  DOSLIJ
  POCZEKAJ
  ZAMIEN
}

enum PendingType {
  OWN_INVOICE
  BL_INVOICE
  ISSUED_WITHOUT_DOCUMENT
  STOCK_MISSING
  DAMAGED_RETURN // (3.6 v1.5): uszkodzony zwrot wrócił korektą na stan wFirmy — do RW, pomniejsza available
}

enum PendingState {
  IN_FLIGHT
  APPLIED
  CONFIRMED
  CANCELLED
  MANUAL
}

enum InvoiceState {
  SENDING // ruch IN_FLIGHT zapisany, żądanie w drodze
  UNKNOWN // timeout: rozstrzyga invoices/find
  ISSUED
  FAILED
}

enum OutboxKind {
  AVAILABLE_CHANGED
  ALLOCATE
  WFIRMA_READ // zlecony odczyt goods/get (po fakturze, po kliknięciu biura)
  FORCE_PUSH // (6.1 pkt 4): kanał sam zmienił stan oferty (anulowanie, odrzucenie) — job wymuszony
}

model Order {
  organizationId      String          @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                  String          @id @default(cuid())
  channel             Channel
  channelAccountId    String
  externalId          String
  externalRevision    String?
  channelStatusRank   Int? // ostatni status kanału jako liczba porządkowa (cofnięcie → DO_WYJASNIENIA)
  status              OrderStatus     @default(NOWE)
  statusBeforeClarify OrderStatus? // T15: powrót z DO_WYJASNIENIA
  carrier             Carrier?
  shippingModule      ShippingModule?
  deliveryMethod      String?
  paymentState        PaymentState
  paymentMethod       String
  totalGross          Decimal         @db.Decimal(12, 2)
  wantInvoiceNip      Boolean         @default(false)
  termsSeasonMode     Boolean? // tryb, wg którego policzono terminy (przełącznik sezonu nie zmienia starych)
  remindAt            DateTime?
  reminderSentAt      DateTime?
  reservationDeadline DateTime?
  // nieudana płatność online: kiedy zwolnić towar (krótki termin z zasad firmy, zamówienie zostaje otwarte) i kiedy
  // zwolniono (zamówienie bez rezerwacji czeka na płatność do `reservationDeadline`)
  stockReleaseAt      DateTime?
  stockReleasedAt     DateTime?
  shortageWaitUntil   DateTime? // „brakuje wszystkiego”: po tym terminie DO_WYJASNIENIA (4.2)
  pendingAction       String? // anulowanie odłożone, bo faktura w drodze (3.5)
  cancelReason        String?
  flags               Json            @default("{}")
  parentOrderId       String? // podzamówienie „dośle później”
  packageNo           Int             @default(1) // numer paczki w id_external faktury
  blOrderId           Int?
  // numer zamówienia widoczny w kanale, gdy inny niż externalId (Woo z numeracją wtyczki), i koszt wysyłki
  // brutto z kanału (null = kanał nie podał albo zamówienie sprzed zmiany). Numer opisowy. Koszt wysyłki ma skutek
  // księgowy: dzieli kwotę faktury na towar i wysyłkę (`kosztWysylkiZamowienia`, lib/dokumenty/pozycje.ts); aktualizacja
  // z kanału (`zapiszOpisZKanalu`) może go zmienić po przyjęciu zamówienia bez wpisu w historii.
  channelNumber       String?
  shippingCostGross   Decimal?        @db.Decimal(12, 2)
  // źródło zamówienia wpisanego w panelu albo przez API ogólne (np. „Telefon”, „Hurt”),
  // jak „Źródło zam.” w BaseLinkerze. Opisowe, bez danych klienta; rdzeń na nim nic nie liczy.
  sourceLabel         String?
  // status firmy przypisany wprost (OrderStatusDef.key). Obowiązuje tylko, gdy jego status bazowy równa
  // się `status`; inaczej (null albo rdzeń przeniósł zamówienie dalej) status firmy wylicza się z `status` i
  // `carrier` (lib/panel/statusy.ts, `wybierzStatusFirmy`). Opisowe: rdzeń na nim nic nie liczy.
  companyStatus       String?
  createdAtChannel    DateTime
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  lines             OrderLine[]
  reservations      Reservation[]
  shortages         Shortage[]
  events            OrderEvent[]
  invoices          InvoiceAttempt[]
  cardPrints        OrderCardPrint[]
  packDrills        PackDrill[]
  shortageDecisions ShortageDecision[]
  shipments         PreparedShipment[]
  carrierShipments  Shipment[]
  returns           Return[]
  customer          OrderCustomer?
  notes             OrderNote[]
  payments          OrderPayment[]
  channelWrites     ChannelWrite[]
  packBasket        PackBasket?
  automationRuns    AutomationRun[]

  @@unique([organizationId, channel, channelAccountId, externalId])
  @@index([organizationId, status, reservationDeadline])
  @@index([parentOrderId])
  @@index([organizationId, createdAtChannel]) // sprzedaż dnia/miesiąca na pulpicie
  @@index([organizationId, updatedAt, id]) // lista zmienionych zamówień w API
  // liczniki panelu; z `companyStatus`, jedno groupBy menu i statusów firmy
  @@index([organizationId, status, carrier, companyStatus])
  @@index([organizationId, totalGross]) // sortowanie listy po kwocie
  // (przegląd końcowy): rozłączność archiwum w raporcie szuka `Order` po koncie i numerze albo id; bez
  // `channel`, bo przy RLS porównanie enum nie jest leakproof i nie może być warunkiem indeksu (zostaje filtrem)
  @@index([organizationId, channelAccountId, channelNumber])
  @@index([organizationId, channelAccountId, externalId])
}

model OrderLine {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  orderId        String
  externalLineId String
  offerId        String?
  productId      String? // STOCKED, BUNDLE albo DIGITAL; null = niezmapowana → DO_WYJASNIENIA (RECZNE: zawsze produkt z katalogu)
  qty            Int // jednostka bazowa produktu; dla zestawu liczba zestawów
  // ilość z kanału (sztuki oferty) przy pozycji z ofertą; null = pozycja bez oferty albo
  // sprzed migracji bez możliwego wyliczenia. Przepięcie i zmiana przelicznika liczą z niej nową ilość bazową.
  qtyChannel     Int?
  qtyRejected    Int          @default(0)
  unitPriceGross Decimal      @db.Decimal(12, 2)
  vatRate        String?
  // opis pozycji z kanału (bez danych klienta): nazwa, SKU/sygnatura i EAN tak, jak podał kanał. Opisowe:
  // mapowanie dalej idzie po `offerId`; karta pokazuje je zwłaszcza przy pozycji bez produktu.
  channelName    String?
  channelSku     String?
  channelEan     String?
  removed        Boolean      @default(false) // pozycja usunięta w kanale (3.7)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  shortages    Shortage[]

  @@unique([orderId, externalLineId])
}

model Reservation {
  organizationId String           @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String           @id @default(cuid())
  orderId        String
  orderLineId    String
  productId      String // zawsze STOCKED (składnik przy zestawie)
  warehouseId    String
  qtyBase        Int
  state          ReservationState @default(ACTIVE)
  releasedReason String? // CANCELLED | EXPIRED_UNPAID | LINE_CHANGED | MOVED_TO_SHORTAGE | FAILED_ONLINE_PAYMENT
  invoiceId      String?
  createdAt      DateTime         @default(now())
  consumedAt     DateTime?
  releasedAt     DateTime?

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line  OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  // + w migracji: UNIQUE (orderLineId, productId, warehouseId) WHERE state = 'ACTIVE'

  @@index([productId, state])
  @@index([orderId, state])
}

model Shortage {
  organizationId String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String        @id @default(cuid())
  orderId        String
  orderLineId    String
  productId      String // STOCKED (składnik przy zestawie)
  qtyBase        Int
  state          ShortageState @default(OPEN)
  reservationId  String?
  note           String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line  OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([productId, state])
  @@index([orderId, state])
}

model PendingMovement {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  productId      String
  warehouseId    String
  delta          Int // zawsze < 0 (wzrosty pokazuje wyłącznie odczyt wFirmy)
  type           PendingType
  state          PendingState
  sentAt         DateTime // nasz zegar
  effectiveAt    DateTime?
  wfirmaDocId    String?
  wzQty          Int?
  orderId        String?
  invoiceId      String?
  confirmedAt    DateTime?
  idempotencyKey String
  // (2.2 pkt 5 v1.5): ilość WZ z osobnego odczytu dokumentu; null po fakturze = odczyt WZ nieudany,
  // ponowienia po 30 s / 2 min / 5 min (`wzTries`, `nextWzReadAt`), dopiero potem jak 0 (MANUAL)
  wzTries        Int          @default(0)
  nextWzReadAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([productId, state])
  @@index([invoiceId])
}

model InvoiceAttempt {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  orderId        String
  packageNo      Int
  attemptNo      Int
  idExternal     String // <orderId>/<n>/<próba>
  state          InvoiceState @default(SENDING)
  wfirmaDocId    String?
  /// Numer dokumentu z programu (np. „SD 15/5/11/26”); null = nieznany (rozstrzygnięty przez find albo wiersz sprzed dodania tego pola)
  number         String?
  /// dokument bez rozchodu (źródło stanu Kompletor) — wystawiany przy „wystawiaj przy” firmy, bez ruchu stanu
  documentOnly   Boolean      @default(false)
  findTries      Int          @default(0)
  nextFindAt     DateTime?
  payload        Json? // pozycje faktury (zestawy rozbite na składniki), bez danych klienta
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idExternal])
  @@index([orderId, packageNo])
}

model OrderEvent {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  orderId        String
  kind           String
  actorId        String
  data           Json?
  createdAt      DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([organizationId, kind, createdAt]) // host zapisu czyta „Wysłane” z numerem nadania z ostatnich dób
}

model InboundEvent {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  source         String
  eventKey       String
  receivedAt     DateTime     @default(now())
  processedAt    DateTime?
  error          String?
  outcome        String?

  @@unique([organizationId, source, eventKey])
}

model OutboxEvent {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  kind           OutboxKind
  productId      String
  offerId        String? // FORCE_PUSH: oferta, której stan zmienił sam kanał
  version        Int?
  createdAt      DateTime // zegar wstrzykiwany (symulacja)
  processedAt    DateTime?
  attempts       Int          @default(0)
  lastError      String?

  @@index([organizationId, kind, processedAt, createdAt])
}

model StockSyncJob {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  offerId          String       @id
  channel          Channel
  channelAccountId String // wysyłka, limity i zdrowie per konto kanału
  targetQty        Int
  sourceVersion    Int
  computedAt       DateTime
  force            Boolean      @default(false) // pełna synchronizacja: wyślij nawet bez zmiany targetu
  firstChangeAt    DateTime // najstarsza niewysłana zmiana (pomiar opóźnienia propagacji)
  attempts         Int          @default(0)
  nextAttemptAt    DateTime
  lastError        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, channel, channelAccountId, nextAttemptAt])
}

model ChannelPushLog {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String       @id @default(cuid())
  offerId          String
  channel          Channel
  channelAccountId String
  mode             ChannelMode // CIEN = „wysłałbym”
  targetQty        Int
  delayMs          Int // od najstarszej niewysłanej zmiany do wysyłki
  createdAt        DateTime

  @@index([channel, createdAt])
}

// import stanów, który kanał przetwarza po przyjęciu pliku (Mirakl STO01 → STO02/STO03). Host zapisuje
// wiersz po przyjęciu pliku, worker czyta wynik co 5 min i alarmuje o odrzuconych wierszach. Bez treści wierszy:
// liczby i do 20 kodów ofert kanału (to nie są dane klientów).
enum StockImportState {
  W_TOKU // kanał jeszcze liczy
  GOTOWE // przetworzony bez odrzuceń
  ODRZUCONE // przetworzony, część wierszy odrzucona (alert)
  NIEUDANE // kanał odrzucił cały import (alert)
  BEZ_WYNIKU // brak wyniku w limicie czasu (alert)
  NIEODCZYTANY // kanał nie podaje wyniku temu kontu (401/403/404) albo konto przełączone na odczyt; nie wiemy, czy stany weszły
}

model ChannelStockImport {
  organizationId     String           @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                 String           @id @default(cuid())
  channel            Channel
  channelAccountId   String
  externalRef        String // np. STO01:<import_id>
  reference          String // referencja paczki stanów hosta
  wierszy            Int // wierszy wysłanych w pliku
  state              StockImportState @default(W_TOKU)
  przyjete           Int?
  odrzucone          Int?
  kodyOdrzuconych    Json             @default("[]")
  proby              Int              @default(0)
  nextCheckAt        DateTime
  checkedAt          DateTime?
  doneAt             DateTime?
  lastError          String? // technika (kod HTTP, ścieżka): do logów, nie na ekran
  uwaga              String? // zdanie dla człowieka na ekranie konta
  odczytWstrzymanyDo DateTime? // po 403/404 odczyty wyniku tego konta wstrzymane do tej chwili
  createdAt          DateTime         @default(now())

  @@unique([organizationId, channel, channelAccountId, externalRef])
  @@index([state, nextCheckAt])
  @@index([createdAt])
}

model ChannelOrderPoll {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String       @id @default(cuid())
  channel          Channel
  channelAccountId String
  startedAt        DateTime
  finishedAt       DateTime?
  ok               Boolean      @default(false)
  error            String?

  @@index([channel, finishedAt])
}

model ChannelHealth {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel          Channel
  channelAccountId String
  failingSince     DateTime?
  lastOkAt         DateTime?
  lastBatchAt      DateTime?
  needsFullSync    Boolean      @default(false)
  /// ostatni przebieg wysyłki stanów konta w PRACA (licznik „pominięte bez zmian” na ekranie konta).
  lastPassAt       DateTime?
  lastPassSent     Int          @default(0)
  lastPassSkipped  Int          @default(0)
  updatedAt        DateTime     @updatedAt

  @@id([organizationId, channel, channelAccountId])
}

/// rejestr synchronizacji stanów (wzorzec sync_ledger z Open Integration Platform, własna implementacja).
/// Jeden wiersz na ofertę konta kanału: skrót treści ostatniego UDANEGO zapisu stanu. Skrót równy treści nowego zapisu
/// = oferta pominięta (kanał ma już tę wartość). Przed wysłaniem skrót jest kasowany, po wyniku OK wpisany na nowo,
/// po każdym innym wyniku zostaje pusty (następny przebieg wysyła). Brak wiersza = zapis jak dawniej.
model ChannelSyncState {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel          Channel
  channelAccountId String
  offerExternalId  String
  /// sha256 kanonicznej treści zapisu (null = brak potwierdzonego zapisu, następny przebieg wysyła)
  contentHash      String?
  /// ilość z ostatniego udanego zapisu (porównanie z odczytem ofert: rozjazd kasuje skrót)
  qty              Int?
  syncedAt         DateTime?
  reference        String?
  /// kolejne trwałe błędy zapisu tej oferty (OK zeruje)
  failures         Int          @default(0)
  lastError        String?
  updatedAt        DateTime     @updatedAt

  @@id([organizationId, channel, channelAccountId, offerExternalId])
}

/// kubełek żetonów limitu tempa integracji (lib/integracje/limity.ts). Jeden wiersz na konto integracji
/// (`kanal:WOO/sklep1`, `przewoznik:dpd`) i zakres (`*` = całe konto albo nazwa zdolności, np. `shipment.create`).
/// Wiersz techniczny: brak = pełny kubełek, skasowanie niczego nie psuje.
model IntegrationRateBucket {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  integrationKey String
  scope          String
  tokens         Float
  /// czy ostatnia próba dostała żeton (zwracane w tym samym zapytaniu)
  granted        Boolean      @default(true)
  updatedAt      DateTime

  @@id([organizationId, integrationKey, scope])
}

/// zdrowie konta integracji i automatyczne wyłączenie po N kolejnych porażkach uwierzytelnienia albo
/// konfiguracji (lib/integracje/zdrowie.ts). Wyłączenie to tylko `disabledAt`: konfiguracja konta (tryb, zapisWlaczony,
/// sekrety) zostaje bez zmian, więc „Włącz ponownie” przywraca konto do poprzedniego stanu.
model IntegrationHealth {
  organizationId      String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  integrationKey      String
  /// channel | carrier | invoicing
  kind                String
  name                String
  consecutiveFailures Int          @default(0)
  lastFailureAt       DateTime?
  lastError           String?
  lastOkAt            DateTime?
  disabledAt          DateTime?
  disabledReason      String?
  /// „Włącz ponownie” zlecone (test połączenia w kolejce)
  enableRequestedAt   DateTime?
  /// nieudana próba włączenia: krok i komunikat
  enableError         String?
  enabledAt           DateTime?
  updatedAt           DateTime     @updatedAt

  @@id([organizationId, integrationKey])
  @@index([organizationId, disabledAt])
}

// Jeden wiersz na firmę (sezon i okresy rezerwacji ustawiane w panelu).
model ReservationPolicy {
  organizationId                String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonMode                    Boolean      @default(false)
  normalReminderBusinessDays    Int          @default(2)
  normalReleaseBusinessDays     Int          @default(5)
  seasonReminderBusinessDays    Int          @default(1)
  seasonReleaseBusinessDays     Int          @default(3)
  allOutOfStockWaitBusinessDays Int          @default(3)
  // Nieudana płatność online (bramka odrzuciła płatność): rezerwacja tylko przez tyle godzin zegarowych od złożenia
  // zamówienia; 0 = zwolnienie przy najbliższym przebiegu wygasania. Przelew tradycyjny: zwykłe terminy wyżej.
  failedOnlinePaymentHoldHours  Int          @default(2)
  // Ta sama nieudana płatność: po ilu dniach kalendarzowych od złożenia (rano, 9:00 czasu polskiego) przypomnienie
  // z pytaniem o problem z płatnością i danymi do przelewu; zwykłe przypomnienie (dni robocze wyżej) jej nie dotyczy.
  failedOnlinePaymentReminderDays Int        @default(1)
  updatedAt                     DateTime     @updatedAt
}

model AuditLog {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  entity         String
  entityId       String
  actorId        String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([entity, entityId])
  @@index([organizationId, entity, createdAt]) // host zapisu czyta zdarzenia NUMER_NADANIA_GOTOWY z ostatnich dób
}

// Sytuacje do obsługi i błędy: panel, a później Telegram; dedupeKey = jedna wiadomość na sprawę.
model Alert {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  kind           String
  ref            String
  message        String
  dedupeKey      String?
  // dane do porównań w kodzie (np. lista zamówień BL alertu zbiorczego); nie trafiają do wiadomości
  data           Json?
  createdAt      DateTime     @default(now())
  closedAt       DateTime?

  @@unique([organizationId, dedupeKey])
  @@index([kind, closedAt])
}

// ═══: firmy, przewoźnicy, sekrety integracji ══════════════════════

// Firma (tenant). Self-host: jedna; hosting: wiele. `id` trafia do ustawienia sesji `app.org_id`, więc tylko
// [a-z0-9_-]. Tabela pod RLS tak jak dane: klient firmy widzi tylko swój wiersz.
model Organization {
  id        String   @id
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  settings  Json     @default("{}") // OrgSettings (lib/organizacje.ts): np. { baselinker: { inventoryId } }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products             Product[]
  bundleComponents     BundleComponent[]
  productImages        ProductImage[]
  productImageData     ProductImageData[]
  warehouses           Warehouse[]
  stocks               Stock[]
  stockMovements       StockMovement[]
  channelOffers        ChannelOffer[]
  channelConfigs       ChannelConfig[]
  blProducts           BlProduct[]
  wfirmaGoods          WfirmaGood[]
  channelOfferImports  ChannelOfferImport[]
  importRuns           ImportRun[]
  importIssues         ImportIssue[]
  jobs                 Job[]
  bulkActions          OrderBulkAction[]
  orders               Order[]
