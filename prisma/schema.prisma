// Reguły „metoda dostawy z kanału → przewoźnik i moduł wysyłki” (spec 7.2), pierwsza pasująca wygrywa.
// `channel` null = każdy kanał; `pattern` = wyrażenie regularne bez rozróżniania wielkości liter, null = zawsze.
model CarrierRule {
  organizationId String         @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String         @id @default(cuid())
  priority       Int
  channel        Channel?
  pattern        String?
  carrier        Carrier
  shippingModule ShippingModule
  // adapter modułu wysyłki jako tekst (np. „basecourier.v1”); null = brak modułu (BRAK)
  adapterKey     String?
  config         Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, priority])
}

// Sekrety integracji firmy (klucze API), szyfrowane AES-256-GCM kluczem z env APP_ENCRYPTION_KEY
// (lib/sekrety.ts). Wartość nigdy nie wychodzi w logach ani w odpowiedziach API; AAD = firma + konto + nazwa.
// Sekret firmy (BL, wFirma): channel/channelAccountId puste. Sekret konta kanału (dwa sklepy Woo, dwa konta
// Allegro): channel + channelAccountId → ChannelConfig. Unikalność firmowych w migracji (indeks częściowy).
model IntegrationSecret {
  organizationId   String         @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String         @id @default(cuid())
  channel          Channel?
  channelAccountId String?
  channelConfig    ChannelConfig? @relation(fields: [organizationId, channel, channelAccountId], references: [organizationId, channel, channelAccountId], onDelete: Restrict)
  name             String // np. BASELINKER_TOKEN, WOO_CONSUMER_KEY
  ciphertext       Bytes
  iv               Bytes
  authTag          Bytes
  keyVersion       Int            @default(1) // wersja klucza głównego (APP_ENCRYPTION_KEYS); 1 = APP_ENCRYPTION_KEY
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([organizationId, channel, channelAccountId, name])
}

// Zużycie AI per firma (decyzja właściciela 25.10, „AI ready na każdym kroku”). Tylko miejsce na zapis — naliczanie
// i rozliczenie z saldem to osobne zadanie; nikt tu nie pisze.
model AiUsage {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  feature        String // funkcja systemu, np. „opis-produktu”
  model          String
  inputTokens    Int
  outputTokens   Int
  costGrosze     Int // koszt w groszach (PLN)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ═══: użytkownicy panelu, przynależność do firm, sesje ═════════════

enum MemberRole {
  WLASCICIEL // wszystkie uprawnienia
  BIURO
  MAGAZYN
}

// Konto osoby — wspólne dla instalacji (w hostingu jedna osoba może należeć do kilku firm). Bez organizationId:
// tabela pod RLS z polityką „nikt” (rola aplikacji jej nie czyta), obsługuje ją wyłącznie lib/auth/sesje.ts.
model User {
  id                 String          @id @default(cuid())
  email              String          @unique // małymi literami
  name               String
  passwordHash       String // argon2id
  active             Boolean         @default(true)
  failedLogins       Int             @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  memberships        Membership[]
  sessions           Session[]
  // hasło startowe (nadane przez inną osobę albo CLI) do zmiany przy pierwszym logowaniu
  mustChangePassword Boolean         @default(false)
  invitationsSent    Invitation[]
  // gęstość panelu wybrana przez osobę (`gesto` | `wygodnie`, lib/panel/gestosc.ts); null = domyślnie gęsto
  gestosc            String?
  // ukryte kolumny tabel panelu per osoba ({ "<id tabeli>": ["klucz", …] }, lib/panel/kolumny.ts)
  kolumnyTabel       Json?
  // alerty nad listą zamówień schowane „Ignoruj” ({ "<id firmy>": { "<rodzaj>": "<podpis>" } }, lib/panel/alerty-listy.ts)
  ukryteAlerty       Json?
  passwordResets     PasswordReset[]
}

// Przynależność osoby do firmy z rolą i dodatkowymi uprawnieniami (lib/auth/uprawnienia.ts). Pod RLS jak dane.
model Membership {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole
  permissions    String[]     @default([])
  /// uprawnienia odebrane osobie z zestawu roli (lib/auth/uprawnienia.ts: rola ∪ permissions − deniedPermissions)
  deniedPermissions String[]  @default([])
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastSeenAt     DateTime? // ostatnia aktywność w TEJ firmie (dotykana z sesją, lib/auth/sesje.ts)

  @@id([organizationId, userId])
  @@index([userId])
}

// Sesja panelu: id = SHA-256 tokenu z ciasteczka (sam token nie jest zapisywany). `organizationId` = firma wybrana
// w przełączniku. RLS z polityką „nikt”, jak User.
model Session {
  id             String        @id
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  expiresAt      DateTime
  userAgent      String?

  @@index([userId])
  @@index([expiresAt])
}

// ═══: cień zamówień (odczyt kanałów przez adaptery, porównanie z BL) ═══════════

// Kursor dziennika zamówień konta kanału (nieprzezroczysty dla rdzenia, format zna adapter) i stan odczytów.
model ChannelCursor {
  organizationId     String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel            Channel
  channelAccountId   String
  adapterKey         String
  cursor             String?
  retryIds           Json         @default("[]") // [{ id, attempts }] — zamówienia do ponownego pobrania (błąd przejściowy)
  coverageFrom       DateTime? // od kiedy odczyt pokrywa kanał (początek pierwszego okna)
  firstPollAt        DateTime?
  lastPollStartedAt  DateTime?
  lastPollFinishedAt DateTime?
  lastOkAt           DateTime?
  failingSince       DateTime?
  lastError          String?
  stats              Json? // liczby ostatniego odczytu
  updatedAt          DateTime     @updatedAt

  @@id([organizationId, channel, channelAccountId])
}

// Kopia zamówienia kanału widzianego w cieniu (bez danych osobowych): co i kiedy przyszło, czy weszło do rdzenia,
// powiązanie z BL. Podstawa metryki opóźnienia i raportu rozjazdów.
model ChannelOrderSnapshot {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String       @id @default(cuid())
  channel          Channel
  channelAccountId String
  externalId       String
  channelNumber    String? // numer zamówienia w kanale/BL, gdy inny niż id (Woo: numeracja wtyczki)
  revision         String
  channelStatus    String
  lifecycle        String // DRAFT | OPEN | CANCELLED | FULFILLED (lib/adaptery/kontrakt.ts)
  paymentState     PaymentState
  totalGross       Decimal      @db.Decimal(12, 2)
  currency         String
  deliveryMethod   String?
  lineCount        Int
  warnings         String[]
  createdAtChannel DateTime
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  revisionSeenAt   DateTime? // kiedy zobaczyliśmy bieżącą rewizję (metryka „zmiana w kanale → u nas”)
  ingestedRevision String?
  ingestOutcome    String? // NOWE | ZMIANA | DUPLIKAT | PRZESTARZALE
  skipReason       String? // szkic | zrealizowane-przed-pierwszym-odczytem | cofniete-po-wysylce
  orderId          String?
  lastError        String?
  errorCount       Int          @default(0)
  blOrderId        Int?
  blStatusId       Int?
  blCheckedAt      DateTime?

  @@unique([organizationId, channel, channelAccountId, externalId])
  @@index([organizationId, createdAtChannel])
}

// Kopia nagłówka zamówienia BL (getOrders, tylko odczyt) do porównania; bez danych klienta.
model BlOrderSnapshot {
  organizationId    String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  blOrderId         Int
  orderSource       String
  orderSourceId     String
  channel           Channel
  channelAccountId  String
  externalRef       String? // shop_order_id (sklep) albo external_order_id (marketplace)
  statusId          Int
  statusName        String?
  deliveryMethod    String?
  paymentDone       Decimal?     @db.Decimal(12, 2)
  totalGross        Decimal?     @db.Decimal(12, 2) // Σ pozycji brutto + wysyłka (sprzedaż dnia)
  confirmed         Boolean? // zamówienie potwierdzone w BL (niepotwierdzone nie liczą się do sprzedaży)
  dateAdd           DateTime
  dateConfirmed     DateTime?
  fetchedAt         DateTime
  statusChangedAt   DateTime? // chwila zmiany statusu z dziennika BL (getJournalList, log_type 18)
  statusChangedToId Int? // status z tego zdarzenia; chwili ufamy tylko, gdy = statusId (inaczej kopia z getOrders nowsza)

  @@id([organizationId, blOrderId])
  @@index([organizationId, channel, channelAccountId, externalRef])
}

// ═══: stanowisko pakowania „na sucho” (ćwiczenie cienia) ══════════════════════════════════════════
// Ćwiczenie zapisuje WYŁĄCZNIE siebie: bez zmiany Order.status, rezerwacji, stanu, braków, faktur i przesyłek.
// Bez danych osobowych: osoba to id konta (User.id), zamówienie to id, pozycje to produkt i ilość.

enum PackDrillOutcome {
  SPAKOWANE
  NIE_SPAKOWANO
}

enum PackDrillFixState {
  OPEN
  CLOSED
  // „Jednak jest” / „Cofnij” na stanowisku: wiersz zostaje w historii, nie liczy się jako brak
  WITHDRAWN
}

// Rejestr wydruków kart zamówień (lib/wydruki/karta-zamowienia.ts). Ponowny wydruk (N+1) unieważnia kod N:
// stanowisko przyjmuje tylko najnowszy `printNo` zamówienia. `orderCode` = kod karty bez numeru wydruku
// (np. „SD48213”, dosyłka „SD48213-2”) — po nim skan karty znajduje zamówienie.
model OrderCardPrint {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  orderId        String
  orderCode      String
  printNo        Int
  printedAt      DateTime     @default(now())
  printedBy      String // User.id
  dryRun         Boolean // karta z plakietką NA SUCHO (konto kanału ze statusMode = CIEN)
  lines          Json // migawka pozycji [{ l: orderLineId, p: productId, q: ilość }] — „karta nieaktualna” po edycji w kanale

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, orderId, printNo])
  @@index([organizationId, orderCode])
}

// Jedno podejście do spakowania zamówienia na stanowisku („na sucho”). `outcome` null = okno otwarte, niezakończone.
model PackDrill {
  organizationId String            @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String            @id @default(cuid())
  orderId        String
  printId        String? // karta, z której pakowano (null = zamówienie otwarte z sesji bez skanu)
  actorId        String // User.id
  startedAt      DateTime
  finishedAt     DateTime?
  outcome        PackDrillOutcome?
  parcelSize     String? // INPOST_A | INPOST_B | INPOST_C | ALLEGRO_A | ALLEGRO_B | ALLEGRO_C | DPD | OSOBISTY
  lines          Json? // [{ l: orderLineId, p: productId, q: do zebrania, zebrane, brak }] przy zakończeniu

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fixes PackDrillFix[]

  @@index([organizationId, startedAt])
  @@index([orderId])
}

// Decyzja obsługi o pozycji z brakiem, jedna na pozycję (podwójne kliknięcie nic nie zmienia). dryRun = konto w cieniu:
// wyłącznie zapis decyzji, rdzeń nietknięty; PRACA: decyzję wykonał rdzeń (lib/stanowisko/decyzje.ts).
model ShortageDecision {
  organizationId       String         @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                   String         @id @default(cuid())
  orderId              String
  orderLineId          String
  action               ShortageAction
  replacementProductId String?
  dryRun               Boolean
  actorId              String // User.id
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, orderLineId])
  @@index([orderId])
}

// Lista „Do poprawy w wFirmie — z ćwiczenia”: „na półce nie było” w ćwiczeniu to realny brak na półce
// (decyzja właściciela, odpowiedź 20). Rezerwacji i stanu nie zmienia.
model PackDrillFix {
  organizationId String            @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String            @id @default(cuid())
  drillId        String
  orderId        String
  orderLineId    String
  productId      String
  qtyBase        Int
  actorId        String // User.id
  createdAt      DateTime          @default(now())
  state          PackDrillFixState @default(OPEN)
  closedAt       DateTime?
  closedBy       String?
  // „Jednak jest” na stanowisku (WITHDRAWN): kto i kiedy cofnął; closedAt/closedBy zostają po biurze
  withdrawnAt    DateTime?
  withdrawnBy    String?

  drill   PackDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, state, createdAt])
  @@index([drillId])
}

// ═══: kolejka pakowania — odbiory kurierów i strefy magazynu ═══════

// Strefa magazynu, z której zbiera się towar (definiuje ją firma w Ustawienia → Strefy
// magazynu). `key` = stały klucz (dawny enum: HERBATY_KAWY, BOMBY_AKCESORIA z dawnego enuma), `name` widoczna nazwa,
// `color` jeden z kolorów panelu (lib/pakowanie/strefy.ts), `sortOrder` kolejność filtrów pakowania.
// Brak strefy = produkt bez reguły i bez ręcznego ustawienia; firma bez stref nie ma filtrów stref.
// Celowo bez FK z Product.packingZone / ProductZoneRule.zone do tej tabeli: spójność kluczy
// pilnuje kod (setProductZone, zapiszStrefy, validatePreset).
model PackingZoneDef {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  key            String
  name           String
  color          String       @default("szary")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, key])
}

// logo firmy w bazie, żeby panel, wydruki i worker maili (osobne wolumeny na Coolify)
// widziały te same bajty. Wiersz = bieżące logo; opis (wymiary, chwila wgrania) w `Organization.settings.logoFirmy`,
// `plik` wiąże oba. Poprzednie wersje idą na dysk do `firma/old/` (nigdy kasowanie).
model OrganizationLogo {
  organizationId String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plik           String // `logo-<id>` z settings.logoFirmy.plik
  ekran          Bytes // PNG ≤ 600×240 (panel, maile)
  druk           Bytes // JPEG ≤ 60 KB (wydruki pdfkit)
  /// „panel” (wgrane w panelu) albo „dysk” (przeniesione z katalogu ZDJECIA_DIR przy pierwszym odczycie)
  zrodlo         String       @default("panel")
  createdAt      DateTime     @default(now())
}

// statusy firmy — warstwa nazw nad enumem OrderStatus. Rdzeń liczy i przechodzi po enumie, ludzie
// widzą nazwy firmy („Do realizacji DPD”). `baseStatus` = status rdzenia, którego to jest nazwa; `carriers` = dla
// których przewoźników (pusta lista = dla każdego). Zamówienie dostaje pierwszy aktywny pasujący status w kolejności
// `sortOrder` (najpierw z przewoźnikiem, potem bez), chyba że ma status przypisany wprost (Order.companyStatus).
// `color` z palety panelu (lib/panel/statusy.ts, `KOLORY_STATUSOW`; dane w lib/panel/statusy-firmy-dane.ts), `customerName` = nazwa dla klienta (np. w mailu), `active`
// false = ukryty (nie przypisuje się nowym zamówieniom, zostaje przy zamówieniach, które go mają). Bez FK z Order,
// spójność kluczy pilnuje kod (zapiszStatusyFirmy: statusu z zamówieniami nie da się usunąć, tylko ukryć).
model OrderStatusDef {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  key            String
  name           String
  customerName   String?
  color          String       @default("szary")
  groupKey       String?
  sortOrder      Int          @default(0)
  baseStatus     OrderStatus
  carriers       Carrier[]    @default([])
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, key])
}

// grupa statusów firmy w panelu listy zamówień (np. „Do realizacji”, „Zakończone”); `collapsed` = grupa
// zwinięta w panelu na start. Status bez grupy stoi na górze panelu (jak „Nowe zamówienia” w BL).
model OrderStatusGroup {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  key            String
  name           String
  sortOrder      Int          @default(0)
  collapsed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, key])
}

// Harmonogram odbioru przewoźnika (jeden odbiór dziennie). Godziny w minutach od północy w Europe/Warsaw.
// W święta z lib/rdzen/kalendarz.ts odbioru nie ma. `example` = wartość przykładowa z seedu, do potwierdzenia.
model CarrierPickup {
  organizationId     String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  carrier            Carrier
  weekdays           Int[] // dni tygodnia ISO: 1 = poniedziałek … 7 = niedziela
  pickupMinute       Int // godzina odbioru
  promiseUntilMinute Int // „wyślemy dziś do”: do tej godziny sklep może obiecywać wysyłkę tego dnia
  active             Boolean      @default(true)
  example            Boolean      @default(false)
  updatedAt          DateTime     @updatedAt

  @@id([organizationId, carrier])
}

// „Przyjechał <przewoźnik>”: kurier odebrał paczki z odbioru dnia `pickupDay`. Dopisywane, nie zmieniane.
model CarrierPickupEvent {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  carrier        Carrier
  pickupDay      String // RRRR-MM-DD (Warszawa): dzień odbioru, który zamyka kliknięcie
  arrivedAt      DateTime
  actorId        String
  actorName      String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, carrier, pickupDay]) // jedno „Przyjechał” na odbiór (podwójne kliknięcie nic nie zmienia)
  @@index([organizationId, carrier, arrivedAt])
}

// Zamówienie podjazdu kuriera u przewoźnika z kolejki pakowania (zdolność shipment.pickup). Jeden aktywny wiersz na
// przewoźnika, moduł, konto i dzień odbioru (rezerwacja pod blokadą przed żądaniem); świadome drugie zamówienie tego
// dnia = kolejna próba (`attempt`). Stany: TWORZENIE (żądanie w drodze), ZAMOWIONY, NIEJEDNOZNACZNY (nie wiadomo, czy
// przewoźnik przyjął; rozstrzyga człowiek), BLAD (odmowa, nic nie zamówiono). Bez danych klientów: liczba i waga paczek.
model CourierPickupOrder {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  carrier        Carrier
  adapterKey     String
  // konto przewoźnika (`config.sekretyKonta` reguły); pusty tekst = konto główne modułu (unikat bez NULL)
  accountKey     String       @default("")
  pickupDay      String // RRRR-MM-DD (Warszawa)
  attempt        Int          @default(1)
  reference      String
  state          String // TWORZENIE | ZAMOWIONY | NIEJEDNOZNACZNY | BLAD
  fromMinute     Int
  toMinute       Int
  parcels        Int
  weightKg       Decimal      @db.Decimal(10, 3)
  // numer zlecenia u przewoźnika i suma kontrolna do anulowania (DPD: orderNumber, checkSum)
  externalRef    String?
  checkSum       String?
  lastError      String?
  failureKind    String?
  requestedBy    String
  requestedName  String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, carrier, adapterKey, accountKey, pickupDay, attempt])
  @@unique([organizationId, reference])
  @@index([organizationId, pickupDay])
}

// „Przyjechał <przewoźnik>” = „Wysłane”. Raport jednej operacji w tle dla kliknięcia (jedno na
// odbiór dnia): ile zamówień przeniesiono do „Wysłane”, ile pominięto i dlaczego (numer zamówienia + powód, bez danych
// klientów). Osobna tabela, bo CarrierPickupEvent jest tylko do dopisywania (rola aplikacji bez UPDATE). Rola aplikacji
// bez DELETE (raport zostaje w historii; REVOKE w 20261109114610).
model CarrierPickupShipping {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId        String // CarrierPickupEvent.id
  carrier        Carrier
  state          String // CZEKA | W_TOKU | ZROBIONE | WYLACZONE | BLAD
  moved          Int          @default(0)
  skipped        Int          @default(0)
  // zamówienia ze sklepów w trybie podglądu (poza kandydatami i poza `skipped`)
  skippedPreview Int          @default(0)
  // [{ nr, powod }] pominiętych (najwyżej 200 pozycji)
  details        Json         @default("[]")
  doneAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, eventId])
}

// Reguła „nazwa albo SKU produktu → strefa”, pierwsza pasująca (rosnąco po priorytecie) wygrywa; ręczne
// `Product.packingZone` ma pierwszeństwo. `pattern` = wyrażenie regularne bez rozróżniania wielkości liter.
model ProductZoneRule {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  priority       Int
  pattern        String
  zone           String // klucz PackingZoneDef.key
  example        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, priority])
}

// ═══: kategorie produktów (drzewo firmy) ══════════════════════════════════════════════════════════════════
// Drzewo kategorii asortymentowych firmy: nazwy, kolejność i przypisania to dane firmy (żadnych nazw w kodzie).
// `path` = zapisana ścieżka nazw rozdzielona „ > ” (np. „Napoje > Soki”), przeliczana w tej samej transakcji przy
// zmianie nazwy i przeniesieniu poddrzewa; filtr całej gałęzi to prefiks ścieżki. `depth` 1 = korzeń, najwyżej 5.
// Nazwa unikalna wśród rodzeństwa (korzenie: indeks częściowy w migracji, bo NULL w unique się nie porównuje).
// Usunięcie kategorii z produktami blokuje FK (Restrict); kod przenosi produkty i usuwa w jednej transakcji.
model ProductCategory {
  organizationId String            @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String            @id @default(cuid())
  parentId       String?
  name           String
  slug           String
  path           String
  depth          Int
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  parent   ProductCategory?  @relation("DrzewoKategorii", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children ProductCategory[] @relation("DrzewoKategorii")
  products Product[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@unique([organizationId, parentId, name])
  @@index([organizationId, path])
}

// ═══: zwroty i korekty (spec 3.5, 3.6, 4.5, 7.4), kolejka wywołań wFirmy (3.4, 8.1) ═══════════════

enum ReturnKind {
  ZWROT // klient odsyła towar
  KOREKTA // korekta bez przesyłki: anulowanie po fakturze (towar na półce), brakująca pozycja na fakturze (4.5)
  REKLAMACJA // reklamacja: ten sam przepływ co ZWROT (paczka wraca), inny powód i mail z planu akcji
}

enum ReturnStatus {
  ZGLOSZONY // zgłoszony (kanał albo obsługa), paczka w drodze
  PRZYJETY // w magazynie, każda pozycja oznaczona („na stan”, „uszkodzone”, „brak”)
  KOREKTA // korekta faktury w kolejce wFirmy albo w drodze (correctionState)
  ZAKONCZONY // korekta wystawiona; stan pokaże odczyt wFirmy (bez ruchu dodatniego, 2.2 pkt 3)
  ODRZUCONY // zwrot odrzucony albo wycofany przed korektą
}

enum ReturnDisposition {
  NA_STAN // sprawny, wraca do sprzedaży (korekta + PZ; brak PZ = lista „korekta bez PZ”)
  USZKODZONE // korekta z PZ, ale do sprzedaży się nie nadaje: ruch DAMAGED_RETURN (lista „uszkodzone do RW”)
  BRAK // pozycja na fakturze, której nie było w paczce (4.5): korekta + ruch STOCK_MISSING
}

model Return {
  organizationId  String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id              String        @id @default(cuid())
  orderId         String
  kind            ReturnKind    @default(ZWROT)
  status          ReturnStatus  @default(ZGLOSZONY)
  invoiceDocId    String? // korygowana faktura (wFirma); jeden zwrot = jedna faktura (paczka). Null = stan Kompletora (zwrot bez korekty w programie do faktur, ruch OWN_RETURN)
  note            String?
  // Korekta przez kolejkę wFirmy: id_external `zwrot/<id>/<próba>`, rozstrzyganie timeoutu jak przy fakturze (3.4)
  correctionTry   Int           @default(0)
  correctionState InvoiceState?
  correctionDocId String?
  findTries       Int           @default(0)
  nextFindAt      DateTime?
  lastError       String?
  receivedAt      DateTime?
  closedAt        DateTime?
  moneyRefundedAt DateTime? // zwrot pieniędzy klientowi (uprawnienie zwroty.pieniadze); rdzeń tylko zapisuje fakt
  // powód (słownik lib/zwroty/powody.ts), źródło zgłoszenia i numer zwrotu w kanale
  reason          String?
  source          String        @default("PANEL") // PANEL | ALLEGRO (zwrot klienta z API Allegro, bez danych kupującego)
  externalId      String? // numer zwrotu w kanale (Allegro customer-returns); unikalny w firmie i źródle
  createdBy       String? // kto założył (id użytkownika albo system:<źródło>)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines ReturnLine[]
  photo ReturnPhoto?

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
  @@index([orderId])
}

// zdjęcie zwrotu (opcjonalne): bajty po osłonie uploadu i ponownym zapisie przez sharp (bez metadanych).
model ReturnPhoto {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  returnId       String       @id
  content        Bytes
  mime           String
  createdAt      DateTime     @default(now())

  ret Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model ReturnLine {
  organizationId String             @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String             @id @default(cuid())
  returnId       String
  orderLineId    String
  productId      String // STOCKED (składnik przy zestawie)
  qty            Int // jednostka bazowa
  disposition    ReturnDisposition?
  pzQty          Int? // ile przyjęła korekta na stan wFirmy (null = brak danych); < qty przy NA_STAN = „korekta bez PZ”
  pzConfirmedAt  DateTime? // biuro: „PZ wystawione” (zdejmuje z listy „korekta bez PZ”)

  ret Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderLineId])
  @@index([organizationId, disposition, pzConfirmedAt]) // lista „korekta bez PZ”
}

// Stan kolejki wywołań wFirmy firmy (jeden klucz API = jedna kolejka): wstrzymanie po limicie, termin pełnego
// odczytu (wstrzymywany przez faktury najwyżej 30 min), test filtra find, raport innych magazynów.
model WfirmaQueueState {
  organizationId        String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pausedUntil           DateTime?
  pauseReason           String?
  fullReadDueSince      DateTime? // pełny odczyt czeka od tej chwili (null = nie zlecony)
  fullReadPage          Int          @default(0) // następna strona pełnego odczytu (1…)
  fullReadSentAt        DateTime? // requestSentAt pierwszej strony bieżącego przebiegu
  lastFullReadAt        DateTime?
  findCheckOkAt         DateTime? // test kontrolny find (filtr id_external działa)
  findCheckFailedAt     DateTime?
  // weryfikacja: osobny test kontrolny find dla korekt (inny endpoint wFirmy niż faktury)
  findCheckCorrOkAt     DateTime?
  findCheckCorrFailedAt DateTime?
  otherWhReportAt       DateTime? // ostatni dzienny raport stanów na pozostałych magazynach (8.1)
  runLockId             String? // dzierżawa przebiegu kolejki
  runLockUntil          DateTime?
  lastNightSyncAt       DateTime? // nocna pełna synchronizacja kanałów firmy
  updatedAt             DateTime     @updatedAt
}

// faktura z BL (getInvoices, tylko odczyt) do rozchodu w cieniu (spec 9.1). Same numery i daty — dane
// nabywcy z faktury nie są zapisywane. `appliedAt` = faktura rozliczona w rdzeniu (applyBlInvoice) albo odłożona
// na stałe (`outcome`).
model BlInvoiceSnapshot {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  blInvoiceId    Int
  blOrderId      Int
  number         String // numer faktury w BL
  externalNumber String? // numer dokumentu w systemie księgowym (wFirma), gdy BL go podaje
  kind           String? // typ z BL (normal | correcting)
  dateAdd        DateTime
  fetchedAt      DateTime
  orderId        String? // nasze zamówienie (po Order.blOrderId)
  appliedAt      DateTime?
  outcome        String? // ZASTOSOWANA | BEZ_WZ | NIC_DO_ROZLICZENIA | KOREKTA | POZA_CIENIEM
  // treść do porównania z naszą fakturą, z tej samej odpowiedzi getInvoices (null = kopia sprzed zmiany).
  // `lines`: SKU, ilość, cena, stawka, znacznik wysyłki; bez nazw pozycji i bez danych nabywcy.
  totalGross     Decimal?     @db.Decimal(12, 2)
  totalNet       Decimal?     @db.Decimal(12, 2)
  paymentName    String?
  lines          Json?
  attempts       Int          @default(0)
  lastError      String?

  @@id([organizationId, blInvoiceId])
  @@index([organizationId, blOrderId])
  @@index([organizationId, appliedAt])
}

// dokumenty WZ z wFirmy (tylko odczyt) i ich powiązanie z zamówieniem. WZ zdejmuje stan w wFirmie; gdy
// rdzeń nie rozliczył faktury (faktura sprzed cienia, zamówienie bez pary z BL), rozliczenie idzie po WZ, a raport
// rozjazdów widzi spadek stanu jako ruch z dokumentem. Bez danych nabywcy: numery, daty, towary wFirmy i ilości.
model WfirmaWzSnapshot {
  organizationId    String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  wfirmaDocId       String
  number            String // np. „WZ 1/11/2026/9”
  docDate           String // data dokumentu w wFirmie (RRRR-MM-DD)
  createdInWfirma   DateTime // chwila założenia dokumentu (czas Warszawy z wFirmy przeliczony na UTC)
  wfirmaWarehouseId String?
  invoiceId         String? // faktura wFirmy, do której jest WZ (null = WZ bez faktury)
  invoiceNumber     String? // jej pełny numer (po nim kopia faktury BL)
  // pozycje: [{ wfirmaGoodId, count }] w jednostce wFirmy
  lines             Json
  orderId           String? // nasze zamówienie, gdy powiązane
  linkedBy          String? // FAKTURA | OPIS | POZYCJE
  outcome           String? // ROZLICZONA | JUZ_ROZLICZONA | CZEKA_NA_FAKTURE_BL | NIC_DO_ROZLICZENIA | BEZ_ZAMOWIENIA | NIEJEDNOZNACZNE | POZA_KATALOGIEM
  candidates        Int? // ile zamówień pasowało po pozycjach (NIEJEDNOZNACZNE)
  fetchedAt         DateTime
  settledAt         DateTime?
  attempts          Int          @default(0)
  lastError         String?
  // opis WZ i surowa chwila założenia z wFirmy — ponowna próba z kopii (poza oknem nakładki)
  // wiąże po numerze zamówienia BL w opisie tak samo jak odczyt z wFirmy
  description       String?
  createdRaw        String?

  @@id([organizationId, wfirmaDocId])
  @@index([organizationId, createdInWfirma])
  @@index([organizationId, invoiceNumber])
}

// próba WZ w programie przy wysyłce bez faktury, zapisana PRZED wywołaniem programu
// (jak `InvoiceAttempt` w stanie SENDING). `ref` = `wz/<orderId>/<paczka>` (klucz idempotencji). Stan: SENDING (wysłane,
// bez odpowiedzi zapisanej w bazie), OK (program oddał dokument; `docId`/`number` zapisane, zanim ruchy zostały
// zamknięte), ERROR (odmowa programu), UNKNOWN (nie wiadomo, czy powstał), LIMIT (limit wywołań: na pewno nie powstał).
// SENDING/UNKNOWN blokuje ponowne wystawienie: kolejne przebiegi tylko szukają dokumentu. Bez danych nabywcy.
model WzAttempt {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ref            String
  orderId        String
  state          String
  docId          String?
  number         String?
  attempts       Int          @default(1)
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, ref])
  @@index([organizationId, orderId])
}

// ostatni udany przebieg zadania cienia (np. `cien-bl-faktury`: odczyt faktur
// BL kompletny). `lastOkAt` = chwila STARTU udanego przebiegu: wszystko, co powstało w BL przed nią, jest już w kopii.
model ShadowJobState {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job            String
  lastOkAt       DateTime
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, job])
}

// wynik dziennego sprawdzenia cienia (dzień w Europe/Warsaw): porównanie sprzedaży dnia z BL
// (`sprzedaz-dnia`) i dzienny raport rozjazdów (`raport-rozjazdow`). `final` = dzień zamknięty (sprawdzony po
// północy); tylko takie liczą się do kryterium 7 dni cienia bez rozjazdów. Same liczby i numery zamówień.
model ShadowDailyCheck {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind           String
  day            String // YYYY-MM-DD
  final          Boolean
  ok             Boolean
  checkedAt      DateTime
  stats          Json

  @@id([organizationId, kind, day])
}

// ═══: automaty BaseLinkera jako reguły w kodzie — plan akcji („wysłałbym”) ═══════════════════

enum ActionMode {
  SUCHO // cień: akcja tylko zaplanowana, nic nie wychodzi (BL robi to sam)
  PRACA // konto w pracy: akcję wykona wysyłka (osobne zadanie: transport + GO właściciela)
}

enum ActionState {
  PLANNED
  SKIPPED // reguła zadziałała, ale akcji nie będzie (powód w `reason`)
  DONE // wykonana (ustawia przyszła wysyłka; silnik planu tego stanu nie nadaje)
}

enum ActionTarget {
  ZAMOWIENIE
  PRODUKT
}

// Plan akcji z reguł lib/akcje/ (zamiennik automatycznych akcji BL). Jeden wiersz = jedna akcja reguły dla celu
// przy danej okazji; unikalność (firma, reguła, cel, okazja) daje idempotencję — drugi przebieg nic nie dokłada.
// Bez adresów, imion, telefonów i treści wiadomości klientów: `vars` to wyłącznie numery, kwoty, daty i SKU,
// a treść maila renderuje się na żądanie (podgląd w panelu). `targetId` = id zamówienia albo produktu, bez FK:
// plan zostaje jako historia także po zmianach celu.
model PlannedAction {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  rule           String // klucz reguły, np. „mail.faktura” (lib/akcje/reguly.ts)
  targetType     ActionTarget
  targetId       String
  occasion       String // klucz okazji, np. „FV:<docId>”, „PRZYPOMNIENIE”, „ponizej:2”
  mode           ActionMode
  state          ActionState  @default(PLANNED)
  reason         String?
  vars           Json         @default("{}") // zmienne do renderu (bez danych osobowych)
  dueAt          DateTime // kiedy akcja by poszła (chwila spełnienia warunku albo przebiegu)
  resolvedAt     DateTime? // warunek ustał (np. stan wrócił powyżej progu) — histereza reguł poziomowych
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, rule, targetId, occasion])
  @@index([organizationId, dueAt])
}

// zaproszenie osoby do firmy w hostingu — dostęp dopiero po zgodzie tej osoby (lib/auth/zaproszenia.ts).
// W bazie wyłącznie SHA-256 tokenu z linku. Czyta je osoba bez sesji firmy, więc jak User i Session: RLS z polityką
// „nikt”, obsługa tylko klientem systemowym, zawsze z firmą w zapytaniu. Jedno otwarte (nieprzyjęte, niecofnięte)
// zaproszenie na firmę i adres: indeks częściowy w migracji 20261103140000_zaproszenia_a069.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String // małymi literami
  role           MemberRole
  permissions    String[]     @default([])
  /// odebrane z zestawu roli; osoba dostaje je przy przyjęciu zaproszenia razem z `permissions`
  deniedPermissions String[]  @default([])
  invitedById    String
  invitedBy      User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  revokedAt      DateTime?
  /// link wysłany przez dostawcę do zaproszonej osoby; false = dostał go zapraszający (konto z linku → mustChangePassword)
  delivered      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@index([expiresAt])
}

// wynik porównania faktury, którą wystawiłby system, z fakturą BL. W cieniu nic nie jest wystawiane.
// Jeden wiersz na fakturę BL: ponowny przebieg nadpisuje wynik. Same liczby, kody i SKU: bez NIP-ów, nazw i adresów
// kontrahentów. `orderNumber` = numer zamówienia w kanale. Kwoty w groszach.
model InvoiceDryRun {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  blInvoiceId    Int
  orderId        String
  orderNumber    String
  day            String // YYYY-MM-DD w Europe/Warsaw, data faktury BL
  result         String // ZGODNA | ROZNICA | BEZ_DANYCH
  scope          String // PELNY | SUMY | BRAK
  categories     String[] // BRAK_POWIAZANIA | ZAOKRAGLENIE | WYSYLKA | VAT | INNE
  diffs          Json         @default("[]")
  oursGrossGr    Int
  oursNetGr      Int
  checkedAt      DateTime

  @@id([organizationId, blInvoiceId])
  @@index([organizationId, day])
}

// ═══: podgląd przesyłki w trybie „przygotuj, nie wysyłaj” ══════════

// Policzona przesyłka: parametry u przewoźnika i problemy, bez danych odbiorcy (Order też ich nie ma). Nic nie zostało
// nadane. Jeden wiersz na zamówienie i paczkę: ponowne przygotowanie nadpisuje wiersz (`createdAt` = chwila przeliczenia).
model PreparedShipment {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  orderId        String
  packageNo      Int
  adapterKey     String
  carrier        Carrier
  courierCode    String?
  parcelSize     String? // gabaryt jak PackDrill.parcelSize
  sideXCm        Int?
  sideYCm        Int?
  sideZCm        Int?
  weightKg       Decimal?     @db.Decimal(8, 3)
  codAmount      Decimal?     @db.Decimal(12, 2) // null = bez pobrania albo kwota nieznana (wtedy problem)
  problems       Json         @default("[]") // ShipmentProblem[]: kody i stałe teksty, bez danych klientów
  createdAt      DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, orderId, packageNo])
  @@index([orderId])
}

// ═══: przesyłki naprawdę (utworzenie u przewoźnika, numer nadania, etykieta) ═══════════════════
// Stan utworzonej przesyłki. Wiersz powstaje (TWORZENIE) PRZED wywołaniem przewoźnika, pod blokadą zamówienia: drugie
// kliknięcie widzi wiersz i nie woła przewoźnika drugi raz. NIEJEDNOZNACZNA = nie wiadomo, czy przesyłka powstała
// (timeout, 5xx po wysłaniu, odszukanie po referencji nie rozstrzygnęło): bez automatycznego ponowienia, tylko
// „Sprawdź u przewoźnika”. BLAD = przewoźnik odmówił (nic nie powstało), wolno spróbować ponownie tą samą referencją.
enum ShipmentState {
  TWORZENIE
  UTWORZONA
  NIEJEDNOZNACZNA
  BLAD
  ANULOWANA
}

// Przesyłka utworzona u przewoźnika. Podgląd `PreparedShipment` zostaje osobno: „Przygotuj” go nadpisuje,
// a tego wiersza nie dotyka. Jedna aktywna przesyłka na paczkę zamówienia (indeks częściowy w migracji). Etykieta ma
// adres odbiorcy, więc jej bajty są zaszyfrowane pierścieniem danych klientów (CUSTOMER_DATA_KEYS, lib/klienci/etykieta.ts)
// i znikają razem z danymi klienta (retencja, RODO). Komunikaty (`lastError`) bez danych klientów.
model Shipment {
  organizationId  String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id              String        @id @default(cuid())
  orderId         String
  packageNo       Int
  // Klucz idempotencji u przewoźnika (deriveReference z firmy, zamówienia, paczki i numeru próby).
  reference       String
  attempt         Int           @default(1)
  state           ShipmentState @default(TWORZENIE)
  adapterKey      String
  carrier         Carrier
  parcelSize      String?
  weightKg        Decimal?      @db.Decimal(8, 3)
  codAmount       Decimal?      @db.Decimal(12, 2)
  // Id przesyłki u przewoźnika (ShipX: id; DPD: numer listu).
  externalRef     String?
  // Numer nadania (do śledzenia, kanału i maila); ShipX nadaje go po chwili. Nie jest daną osobową.
  trackingNumber  String?
  labelFormat     String? // PDF | ZPL
  labelCiphertext Bytes?
  labelIv         Bytes?
  labelAuthTag    Bytes?
  labelKeyVersion Int?
  labelFetchedAt  DateTime?
  labelError      String?
  lastError       String?
  failureKind     String? // PRZEJSCIOWY | TRWALY | NIEJEDNOZNACZNY z ostatniej próby
  requestedBy     String?
  // śledzenie przesyłki (zdolność shipment.track): ostatni status u przewoźnika i chwila odczytu
  carrierStatus   String?
  trackedAt       DateTime?
  // Śledzenie zakończone (anulowana u przewoźnika, nieznany stan przez kilka dni, przesyłka nie istnieje): przesyłka
  // wypada z próbkowania; zostaje ręczne „Przyjechał kurier”. trackingUnknownSince = pierwszy z nieprzerwanej serii
  // odczytów bez znanego stanu (null = ostatni odczyt dał znany stan).
  trackingStoppedAt    DateTime?
  trackingUnknownSince DateTime?
  // Oś statusów przesyłki (lib/wysylka/stany-przesylki.ts), zapisywana przy włączonym „Śledź paczki aż do
  // doręczenia”: ostatni stan drogi paczki i od kiedy (czas zdarzenia u przewoźnika albo chwila odczytu), pierwsze
  // przekazanie przewoźnikowi, doręczenie oraz termin następnego odczytu (null = stan końcowy albo bez osi).
  // trackFailures = nieudane odczyty z rzędu (zerowane udanym odczytem): odstęp po błędzie rośnie, po 20 koniec.
  // Indeks terminu odczytu jest częściowy (WHERE trackingStoppedAt IS NULL), tylko w migracji
  // 20261114289000_sledzenie_os_statusow, jak Shipment_aktywna_paczka.
  trackState      ShipmentTrackState?
  trackStateSince DateTime?
  handedOverAt    DateTime?
  deliveredAt     DateTime?
  nextTrackAt     DateTime?
  trackFailures   Int                 @default(0)
  // Reguły firmy na osi (lib/wysylka/reguly-drogi.ts): trackRulesPending = jest wiersz historii, dla którego reguły
  // jeszcze nie zadziałały (ustawiane razem z wierszem, zdejmowane razem ze skutkami reguł w jednej transakcji);
  // trackRulesAt = `observedAt` ostatniego obsłużonego wiersza. Indeks oczekujących częściowy, tylko w migracji
  // 20261114289100_reguly_osi_przesylek. trackRulesFailures = nieudane próby reguł z rzędu (zerowane udaną próbą
  // i nowym wierszem); po REGULY_DROGI_PROB próbach znacznik schodzi do następnej zmiany stanu paczki.
  trackRulesPending  Boolean   @default(false)
  trackRulesAt       DateTime?
  trackRulesFailures Int       @default(0)
  // Dodatkowa przesyłka do tego samego zamówienia (lib/wysylka/dodatkowa.ts): extraNo 0 = główna, 1..n = dodatkowe
  // (dosyłka, paczka zastępcza, druga paczka) z rodzajem, powodem, regułą przewoźnika i kosztem netto wpisanym ręcznie.
  // Indeksy częściowe (główna: jedna aktywna na paczkę; dodatkowa: jeden wiersz na numer) i warunek pól tylko
  // w migracji 20261114289200_przesylka_dodatkowa.
  extraNo      Int      @default(0)
  extraKind    String?
  extraReason  String?
  extraRuleId  String?
  extraCostNet Decimal? @db.Decimal(12, 2)
  // konto przewoźnika (`config.sekretyKonta` reguły, np. EMPIK); null = konto główne modułu
  accountSuffix   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackEvents ShipmentTrackEvent[]

  @@unique([organizationId, reference])
  @@index([orderId, packageNo])
  @@index([organizationId, trackingNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, adapterKey, accountSuffix])
}

// Stan drogi paczki na osi wspólnej dla przewoźników (lib/wysylka/stany-przesylki.ts). Inny niż ShipmentState
// (stan tworzenia etykiety).
enum ShipmentTrackState {
  UTWORZONA
  PRZEKAZANA
  W_DRODZE
  W_DORECZENIU
  W_PUNKCIE
  DORECZONA
  NIEUDANE_DORECZENIE
  ZWROT
  PROBLEM
  ANULOWANA
  NIEZNANY
}

// Historia śledzenia przesyłki: jeden wiersz na każdą zmianę stanu na osi albo kodu u przewoźnika. Bez danych
// klientów: `carrierCode` = sam kod zdarzenia, z którego wyliczono stan (pusty, gdy przewoźnik go nie podał),
// `carrierStatus` = ostatnie zdarzenie przewoźnika jak w `Shipment.carrierStatus` (u DPD z opisem). Opis stanu po polsku
// liczy się przy wyświetlaniu (OPIS_STANU_DROGI), nie jest zapisywany. `occurredAt` = czas zdarzenia u przewoźnika,
// a gdy go nie podał, chwila odczytu. Unikalność z kodem = ponowiony zapis bez dubli, a dwa kody w tej samej chwili
// i stanie to dwa wiersze (import pełnej listy zdarzeń: createMany + skipDuplicates).
model ShipmentTrackEvent {
  organizationId String             @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String             @id @default(cuid())
  shipmentId     String
  state          ShipmentTrackState
  carrierCode    String             @default("")
  carrierStatus  String?
  occurredAt     DateTime
  observedAt     DateTime           @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shipmentId, occurredAt, state, carrierCode])
  @@index([shipmentId, occurredAt])
}

// ═══: dziennik zdarzeń BL (getJournalList) ════════════════════════════════════════════════════════
// Kursor dziennika BL per firma: ostatni przetworzony wpis (`lastLogId`) i chwila ostatniego udanego odczytu.
// Zdarzenia zmiany statusu odświeżają `BlOrderSnapshot` poza oknem porównania (lib/cien/dziennik-bl.ts).
// Bez danych klientów: same liczby i daty.
model BlJournalCursor {
  organizationId String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lastLogId      BigInt       @default(0)
  lastReadAt     DateTime? // ostatni udany odczyt dziennika (> 72 h temu = zdarzenia utracone, BL trzyma 3 dni)
  lastEventAt    DateTime? // ostatni przebieg, w którym dziennik dał zdarzenie (sygnał wyłączonej metody)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ═══: klucze API dla systemów zewnętrznych ═════════════════════════

// Klucz API firmy (hurt-demo, EasyTools, BotKlienta): w bazie wyłącznie SHA-256 klucza (`tokenHash`, jak Session) i
// `prefix` do rozpoznania na ekranie. Pełny klucz widać jeden raz, po utworzeniu. `scopes` z lib/api/zakresy.ts.
// Odwołanie = `revokedAt`, wiersz zostaje (historia). `tokenHash` unikalny w całej bazie: klucz wskazuje firmę.
model ApiKey {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  name           String
  prefix         String
  tokenHash      String       @unique
  scopes         String[]
  // klucz obsługi klienta: konta sprzedaży, które widzi ({ wszystkie: true } albo { konta: [{ kanal, konto }] });
  // null = brak kont (klucz obsługi nie widzi niczego); klucze ogólne tego pola nie używają (lib/api/konta-klucza.ts)
  accounts       Json?
  createdBy      String
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  mcpCalls       McpCall[]

  @@index([organizationId, createdAt])
}

// ─── Serwer MCP dla agentów AI: dziennik wywołań narzędzi ───────────────────────────────────────────
// Jeden wiersz na wywołanie narzędzia (lib/mcp/dziennik.ts). BEZ treści argumentów i wyników (mogą nieść numery
// zamówień i nazwy): tylko nazwa narzędzia, wynik, czas, liczba pozycji i NAZWY użytych parametrów. Retencja 90 dni
// (zadanie workera mcp-sprzatanie). `source` = skąd kontekst: klucz API (/api/mcp) albo sesja panelu (asystent).

enum McpCallSource {
  KLUCZ
  PANEL
}

enum McpCallResult {
  OK
  ODMOWA
  BLAD
  LIMIT
}

model McpCall {
  organizationId String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String        @id @default(cuid())
  source         McpCallSource
  apiKeyId       String?
  apiKey         ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  userId         String?
  tool           String
  result         McpCallResult
  durationMs     Int
  items          Int?
  params         String[]
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([apiKeyId, createdAt])
}

// ─── Serwer druku: stanowiska z agentem druku (agent-druku/) i kolejka zleceń ─────────────────────────
// Agent na komputerze w magazynie pyta GET /api/druk/zlecenia tokenem stanowiska i odsyła wynik. Kontrakt:
// agent-druku/src/kontrakt.ts i agent-druku/README.md, sekcja 4; opis serwera: docs/druk.md.

enum PrintJobType {
  karta
  lista
  spis
  etykieta
}

enum PrintJobSource {
  PANEL // klik w panelu (karty, lista, etykieta próbna)
  TEST // „Wydruk testowy” z Ustawienia → Druk
  ZAPAS // nowe zlecenie na roli zapasowej po awarii drukarki termicznej (fallbackOfId = oryginał)
}

enum PrintJobStatus {
  PRZYGOTOWANIE // zarezerwowane (klucz idempotencji), plik jeszcze się rysuje — agent go nie dostaje
  OCZEKUJE // plik zapisany, agent może drukować
  OK // agent: zadanie przyjęte przez kolejkę Windows
  BLAD // agent albo serwer (błąd rysowania): nie wydrukowano albo nie wiadomo; komunikat w resultMessage
  WYGASLO // nikt nie wydrukował w 8 godzin — agent już go nie dostanie
}

enum PrintFileFormat {
  pdf
  zpl
}

// Stanowisko druku = jeden komputer z agentem. Token stanowiska tylko jako SHA-256 (pełny pokazany raz w panelu).
model PrintStation {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  code           String // `stanowisko` w agent-druku.json: litery bez polskich znaków, cyfry, - i _
  name           String
  tokenHash      String?      @unique // SHA-256 tokenu kmd_…; null = brak aktywnego tokenu
  tokenCreatedAt DateTime?
  routing        Json         @default("{}") // typ zlecenia → rola drukarki, np. { "karta": "A4", "etykieta": "TERMICZNA_1" }
  printers       Json         @default("[]") // ostatni RaportStanu.drukarki (rola, nazwa Windows, stan, komunikat, kolejka)
  agentVersion   String?
  lastReportAt   DateTime? // czas serwera przy ostatnim POST /api/druk/stan
  disabledAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs PrintJob[]

  @@unique([organizationId, code])
}

// Zlecenie druku. Wiersz zostaje jako historia; bajty pliku (PrintJobFile) czyści worker 7 dni po zakończeniu.
model PrintJob {
  organizationId String          @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String          @id @default(cuid()) // = ZlecenieDruku.id u agenta ([A-Za-z0-9_-]{1,100})
  stationId      String
  type           PrintJobType
  source         PrintJobSource
  role           String // rola drukarki (A4, A4_2, TERMICZNA_1…) — tekst, bo role są otwarte (wzór w lib/druk/role.ts)
  format         PrintFileFormat // plik, który dostaje agent (etykieta na A4 = pdf)
  copies         Int             @default(1)
  status         PrintJobStatus  @default(PRZYGOTOWANIE)
  idempotencyKey String? // klucz kliknięcia z przeglądarki: podwójny klik = to samo zlecenie
  fallbackOfId   String?         @unique // zlecenie zapasowe: najwyżej jedno na oryginał
  summary        String? // krótki opis dla panelu (np. „Karty: 1001/2, 1002/1”), bez danych klientów
  resultMessage  String?
  resultPrinter  String?
  reportedAt     DateTime?
  requestedBy    String? // User.id
  orderIds       String[]        @default([])
  expiresAt      DateTime
  createdAt      DateTime        @default(now())

  station    PrintStation   @relation(fields: [stationId], references: [id], onDelete: Restrict)
  fallbackOf PrintJob?      @relation("PrintJobFallback", fields: [fallbackOfId], references: [id], onDelete: SetNull)
  fallback   PrintJob?      @relation("PrintJobFallback")
  files      PrintJobFile[]

  @@unique([organizationId, idempotencyKey])
  @@index([stationId, status, createdAt])
  @@index([organizationId, createdAt])
}

// Bajty pliku zlecenia: osobno, bo etykieta ma dwie wersje (ZPL i PDF), a lista zleceń nie może czytać bajtów.
model PrintJobFile {
  organizationId String          @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String          @id @default(cuid())
  jobId          String
  format         PrintFileFormat
  data           Bytes
  createdAt      DateTime        @default(now())

  job PrintJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, format])
}

// ═══: KSeF dla firm bez wFirmy, „przygotuj, nie wysyłaj” ═══════════

// Szkic faktury FA(3) zamówienia i paczki (lib/ksef/szkice.ts). Nic nie zostało wysłane do KSeF. `xml` bez danych
// nabywcy: nabywca to stała zastępcza z `BrakID` = 1; prawdziwy trafia do XML dopiero przy wysyłce (osobne zadanie).
// `numer` null = szkic (P_2 = SZKIC-<id>); ponowne przygotowanie nadpisuje wiersz tylko, dopóki numer jest pusty.
// Statusy tekstem z listą w kodzie: ZLOZONA | BLAD_WALIDACJI | POZA_KSEF | ODLOZONA; też WYSYLANA,
// WYSLANA (KSeF przetwarza), PRZYJETA (numer KSeF i UPO), ODRZUCONA (KSeF odrzucił), BLAD_WYSYLKI (nie doszła).
model KsefInvoiceDraft {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id
  orderId        String
  packageNo      Int
  status         String
  numer          String?
  seriaKod       String?
  wersjaSchemy   String
  xml            String?
  xmlSha256      String?
  bruttoGr       Int
  nettoGr        Int
  problems       Json         @default("[]") // ProblemFa3[]: kody, ścieżki pól i stałe teksty, bez danych klientów
  walidacja      Json         @default("{}") // WynikWalidacji: POPRAWNY | BLEDY | XSD_NIEDOSTEPNY
  // wysyłka do KSeF i korekty. `rodzaj` VAT (faktura) albo KOR (korekta przy zwrocie: `returnId`, faktura
  // korygowana `korygowanaId`). Faktura ma `returnId` = "" (klucz unikalny bez NULL). Numer z serii przydziela się raz,
  // przy pierwszej wysyłce, razem z `dataWystawienia`; ponowienie wysyła ten sam numer (KSeF odrzuca dubel kodem 440).
  // XML z nabywcą nie jest zapisywany: składa się od nowa z bazy przy każdej próbie (dane klienta tylko zaszyfrowane).
  rodzaj         String       @default("VAT")
  returnId       String       @default("")
  korygowanaId   String?
  dataWystawienia String?
  srodowisko     String? // TEST | DEMO | PROD: gdzie poszła ostatnia próba
  sesjaRef       String? // numer referencyjny sesji interaktywnej KSeF
  fakturaRef     String? // numer referencyjny faktury w sesji (status i UPO)
  ksefNumer      String? // numer KSeF nadany przez MF
  upo            String? // UPO (XML) z KSeF
  proby          Int          @default(0)
  wysylkaOd      DateTime? // początek bieżącej próby (sprzątacz porzuconych)
  przyjetaAt     DateTime?
  lastError      String? // komunikat KSeF albo powód odmowy, bez danych nabywcy
  // (utwardzenie przed pierwszą produkcyjną fakturą). `wytworzonaAt` = DataWytworzeniaFa zamrożona razem
  // z numerem, więc XML przy ponowieniu jest bajt w bajt ten sam (ten sam hash), dopóki dane się nie zmienią.
  // `hasheWyslane` = SHA-256 (base64) XML-i, które mogą być w KSeF (dopisywane PRZED wysłaniem, zdejmowane po pewnym
  // odrzuceniu); `invoiceHash` = hash dokumentu przyjętego do przetwarzania (202) albo dopasowanego oryginału.
  // `przyczyna` = kod błędu (lib/ksef/przyczyny.ts) zamiast dopasowania tekstu `lastError`; automat ponawia tylko
  // przyczyny „nasze” (sieć, limit czasu, 429/5xx przed 202, logowanie, porzucona próba), do `ponowieniaAuto` prób
  // z odstępem `nastepnaProbaOd`. `probyOdczytu` = nieudane odczyty stanu po wysłaniu (osobno od `proby`).
  // `probyUzupelnienia` = nieudane dociągnięcia numeru KSeF/UPO przyjętej faktury.
  wytworzonaAt      DateTime?
  invoiceHash       String?
  hasheWyslane      String[]  @default([])
  przyczyna         String?
  probyOdczytu      Int       @default(0)
  ponowieniaAuto    Int       @default(0)
  nastepnaProbaOd   DateTime?
  probyUzupelnienia Int       @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, orderId, packageNo, returnId])
  @@unique([organizationId, numer])
  @@index([orderId])
  @@index([organizationId, rodzaj, createdAt])
  // zapytania automatu (ponowienia `BLAD_WYSYLKI` i dociąganie `PRZYJETA` po `nastepnaProbaOd`)
  @@index([organizationId, status, nastepnaProbaOd])
}

// Seria numeracji faktur firmy bez wFirmy (lib/ksef/numeracja.ts). Wiersz na okres (`periodKey`: „2026”, „2026-11”
// albo „-” przy NIGDY); `lastNo` rośnie atomowo w transakcji zatwierdzenia do wysyłki, nigdy przy szkicu.
model InvoiceNumberSeries {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  pattern        String // np. FV/{NR}/{MM}/{RRRR}
  resetPeriod    String // ROK | MIESIAC | NIGDY
  periodKey      String
  lastNo         Int
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, code, periodKey])
}

// ═══: alerty na Zulip ══════════════════════════════════════════════

// Ustawienia powiadomień firmy (Ustawienia → Powiadomienia). Domyślnie wyłączone; wysyłka wymaga też env instancji
// POWIADOMIENIA_WYSYLKA=1. Klucz bota to sekret firmy ZULIP_API_KEY (IntegrationSecret), nigdy tutaj.
// `enabledAt` = chwila ostatniego włączenia: starsze alerty nie wychodzą. `lastError` = powód automatycznego wyłączenia
// (401/403) albo błąd konfiguracji, bez klucza i bez treści alertów.
model NotificationSettings {
  organizationId String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enabled        Boolean      @default(false)
  enabledAt      DateTime?
  zulipSite      String?
  zulipBotEmail  String?
  routes         Json         @default("{}") // grupa alertu → { stream, topic } (lib/powiadomienia/grupy.ts)
  lastError      String?
  lastErrorAt    DateTime?
  updatedById    String?
  updatedAt      DateTime     @updatedAt
}

// Dostarczenie jednego alertu: najwyżej jedna wiadomość na alert (unikalność w firmie). Stany: SENDING (zapisany przed
// wywołaniem), SENT, FAILED (z `nextAttemptAt` = czeka na ponowienie, bez = koniec), UNCERTAIN (timeout po wysłaniu
// albo przerwany worker — bez ponowienia). `lastError` bez treści alertu i bez klucza.
model AlertDelivery {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  alertId        String
  kind           String
  group          String
  state          String
  attempts       Int          @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, alertId])
  @@index([organizationId, state, nextAttemptAt])
  @@index([organizationId, lastAttemptAt])
}

// ═══: kanały i oferty bez BaseLinkera ══════════════════════════════

// Stan konta kanału widziany z panelu: wynik ostatniego testu połączenia (bez treści odpowiedzi kanału i bez sekretów)
// i ostatnie pobranie ofert. Osobno od ChannelConfig.config (ustawienia adaptera) i ChannelHealth (zdrowie zapisu
// stanów), żeby kliknięcie w panelu nie zmieniało ustawień ani zdrowia. `createdInPanel` = konto założone w panelu.
model ChannelAccountStatus {
  organizationId    String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel           Channel
  channelAccountId  String
  createdInPanel    Boolean      @default(false)
  testRequestedAt   DateTime?
  testCheckedAt     DateTime?
  testOk            Boolean?
  testMessage       String?
  // nazwy kluczy meta_data z ostatnich zamówień (test połączenia Woo), bez wartości: { sample, keys: [{ key, orders }], at }
  testMetaKeys      Json?
  offersRequestedAt DateTime?
  offersRunId       String? // ImportRun ostatniego pobrania ofert (kind „kanal-oferty”)
  updatedAt         DateTime     @updatedAt

  @@id([organizationId, channel, channelAccountId])
}

// Oferta kanału z ostatniego odczytu (`listOffers`), także ta bez powiązania: lista „Do przypisania”. Bez danych
// klientów. Ilość tylko informacyjnie: system nie jest lustrem kanału (stan startowy bierze się raz, przy zakładaniu).
model ChannelOfferRead {
  organizationId   String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String       @id @default(cuid())
  channel          Channel
  channelAccountId String
  externalId       String
  sku              String?
  ean              String?
  name             String?
  qty              Int?
  // cena brutto i VAT z oferty (gdy kanał je podaje) i adresy zdjęć — do produktu zakładanego z oferty
  priceGross       Decimal?     @db.Decimal(12, 2)
  vatRate          String?
  imageUrls        String[]     @default([])
  active           Boolean      @default(true)
  // POWIAZANA | BEZ_SKU | WIELOZNACZNE | BEZ_PRODUKTU | BLAD (lib/kanaly/oferty.ts)
  state            String
  note             String?
  runId            String
  seenAt           DateTime

  @@unique([organizationId, channel, channelAccountId, externalId])
  @@index([organizationId, channel, channelAccountId, state])
}

// ═══: dane klienta w zamówieniu (zapis szyfrowany, wgląd wg uprawnień, retencja) ═══════════

enum CustomerDataSource {
  KANAL // odczyt z kanału (zadanie KLIENT_ZAPIS albo „Odśwież z kanału”)
  RECZNE // wpisane przez człowieka (zamówienie ręczne); automat go nie nadpisuje
  PRZEPROWADZKA // przeniesione z BaseLinkera (przeprowadzka)
}

// Klient zamówienia (lib/klienci/*). Jeden zaszyfrowany JSON całego rekordu (nabywca, dostawa, punkt odbioru, faktura,
// telefon, e-mail, uwagi klienta) AES-256-GCM kluczem z env CUSTOMER_DATA_KEYS (osobny pierścień, nie klucz sekretów
// integracji); AAD = „<firma>:klient:<Order.id>”. Żadnej kolumny z jawną wartością danych osobowych: wyszukiwanie po
// skrótach HMAC (CUSTOMER_LOOKUP_KEY). Odszyfrowanie wyłącznie w lib/klienci/* (strażnik tests/klienci-straznik.test.ts).
model OrderCustomer {
  organizationId String             @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String             @id @default(cuid())
  orderId        String             @unique
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  keyVersion     Int // wersja klucza z CUSTOMER_DATA_KEYS
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  emailHash      String? // HMAC-SHA256 znormalizowanego e-maila (lib/klienci/skroty.ts)
  phoneHash      String?
  nipHash        String?
  source         CustomerDataSource
  fetchedAt      DateTime // chwila odczytu z kanału albo wpisu człowieka
  revision       Int                @default(1) // licznik odświeżeń
  retainUntil    DateTime? // termin retencji (lib/klienci/retencja.ts); null = nieustalony
  purgedAt       DateTime? // dane usunięte (retencja albo RODO art. 17): szyfrogram pustego rekordu, skróty puste
  // kraj dostawy (kod ISO, dwie litery) jawnie, do filtra „Kraj” na liście zamówień. Sam kod kraju nie
  // wskazuje osoby; reszta adresu zostaje w szyfrogramie. Usunięcie danych (retencja, RODO) czyści go razem ze skrótami.
  country        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, emailHash])
  @@index([organizationId, phoneHash])
  @@index([organizationId, nipHash])
  @@index([organizationId, retainUntil])
  @@index([organizationId, country])
}

// Ustawienia danych klientów firmy (wzorem NotificationSettings): jeden wiersz na firmę, brak = domyślne.
// Wartości retencji domyślnie 5 lat / 36 miesięcy — do potwierdzenia przez księgową.
model CustomerDataSettings {
  organizationId             String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  zapisWCieniu               Boolean      @default(false) // daneKlientaWCieniu: zapis także dla kont w trybie cienia
  retencjaZFakturaLat        Int          @default(5)
  retencjaBezFakturyMiesiecy Int          @default(36)
  trybRetencji               String       @default("RAPORT") // RAPORT | USUWAJ
  ostatniPrzebiegAt          DateTime?
  ostatniPoTerminie          Int?
  ostatnioUsunieto           Int?
  updatedById                String?
  updatedAt                  DateTime     @updatedAt
}

// ═══: karta zamówienia docelowa ═══════════════════════════════════

// Notatka wewnętrzna biura i magazynu (≤ 2000 znaków). Treść nie idzie do AI, alertów ani logów; na wydruk karty tylko
// z `showOnCard`. Poprawia ją wyłącznie autor przez 15 minut (lib/karta/notatki.ts); nikt jej nie kasuje.
model OrderNote {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  orderId        String
  body           String
  actorId        String // user:<id>
  showOnCard     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  editedAt       DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum OrderPaymentKind {
  WPLATA // wpłata zapisana w Kompletorze (np. przelew po „Oznacz jako opłacone”)
  DOPLATA // dopłata klienta po zmianie pozycji
  ZWROT // zwrot różnicy klientowi (pozycja do eksportu przelewów, lib/zwroty/eksport-przelewow.ts)
}

// Wpłaty, dopłaty i zwroty różnicy zapisane z karty (tylko zapis w Kompletorze: bez banku i bez linków płatności).
// Kwota zawsze dodatnia, znak wynika z rodzaju. `exportedAt` = zwrot wyszedł w pliku przelewów (eksport to osobne zadanie).
model OrderPayment {
  organizationId String           @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String           @id @default(cuid())
  orderId        String
  kind           OrderPaymentKind
  amount         Decimal          @db.Decimal(12, 2)
  method         String? // słowo z listy (przelew, gotówka, karta, inna), bez danych klienta
  paidAt         DateTime
  actorId        String
  exportedAt     DateTime?
  createdAt      DateTime         @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, paidAt])
  @@index([organizationId, kind, exportedAt])
}

// ═══: poczta do klientów i biura ══════════════════════════════════

// Ustawienia → Poczta: transport SMTP firmy (Amazon SES przez jego punkt SMTP). Hasło to sekret firmy SMTP_PASSWORD
// (IntegrationSecret), tu nigdy. Wysyłka wymaga włącznika firmy i POCZTA_WYSYLKA=1 na instancji; bez nich plan akcji
// czeka (PlannedAction PLANNED), nic nie ginie. `senders` = nadawca i wygląd per konto kanału („<KANAŁ>:<konto>”,
// lib/poczta/ustawienia.ts), bez danych klientów.
model MailSettings {
  organizationId  String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enabled         Boolean      @default(false)
  enabledAt       DateTime?
  host            String?
  port            Int?
  security        String       @default("STARTTLS") // TLS | STARTTLS | BRAK (tylko serwer lokalny)
  username        String?
  fromEmail       String?
  fromName        String?
  officeEmail     String? // adresat maili do biura (błąd faktury, niski stan)
  senders         Json         @default("{}")
  lastError       String?
  lastErrorAt     DateTime?
  // serwer odrzucił login/hasło: wysyłka i linki resetu hasła stoją do zmiany danych SMTP albo ponownego włączenia
  loginRejectedAt DateTime?
  // czytnik odbić (raporty o niedoręczeniu) ze skrzynki nadawcy przez IMAP; hasło = sekret IMAP_PASSWORD
  bounceEnabled   Boolean      @default(false)
  imapHost        String?
  imapPort        Int?
  imapSecurity    String       @default("TLS") // TLS | STARTTLS | BRAK (tylko serwer lokalny)
  imapUsername    String?
  imapFolder      String       @default("INBOX")
  bounceAddress   String? // nadawca koperty (Return-Path); puste = adres nadawcy maila
  bounceState     Json         @default("{}") // { uidValidity, lastUid, failUid, failCount }
  bounceCount     Int          @default(0)
  bounceLastRunAt DateTime?
  bounceLastError String?
  bounceLastErrorAt DateTime?
  // serwer IMAP odrzucił login: czytnik stoi do zmiany danych skrzynki (wysyłka maili działa dalej)
  bounceLoginRejectedAt DateTime?
  // wersja ustawień skrzynki: rośnie przy zmianie skrzynki albo włączeniu; czytnik zapisuje wynik tylko przy tej samej wersji
  bounceRev       Int          @default(0)
  updatedById     String?
  updatedAt       DateTime     @updatedAt
}

// Treść szablonu maila zmieniona w panelu (Ustawienia → Poczta → Szablony). Brak wiersza = treść domyślna z kodu
// (lib/maile/szablony.ts). Kształt jak NadpisanieSzablonu; sprawdzany przy zapisie i przy wysyłce.
model MailTemplate {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind           String // RodzajMaila
  subject        String?
  preheader      String?
  heading        String?
  blocks         Json?
  updatedById    String?
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, kind])
}

// Wysyłka jednego maila: najwyżej jedna na zdarzenie (unikalny `dedupeKey`: „plan:<PlannedAction.id>”, „test:<id>”,
// „reset:<PasswordReset.id>”). Stany jak AlertDelivery: SENDING zapisany PRZED wywołaniem serwera, SENT, FAILED
// (z `nextAttemptAt` = ponowienie, bez = koniec), UNCERTAIN (zerwane po wysłaniu treści, bez ponowienia), CZEKA
// (brak danych do maila, np. PDF dokumentu; bez próby), POMINIETY. `recipient` zamaskowany, bez pełnego adresu.
model MailDelivery {
  organizationId  String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id              String       @id @default(cuid())
  dedupeKey       String
  kind            String
  plannedActionId String?
  state           String
  recipient       String?
  attempts        Int          @default(0)
  nextAttemptAt   DateTime?
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  messageId       String?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, state, nextAttemptAt])
  @@index([organizationId, lastAttemptAt])
  @@index([organizationId, plannedActionId])
}

// Reset hasła mailem: jednorazowy link ważny 60 min. W bazie tylko SHA-256 tokenu (`tokenHash`); sam token żyje
// zaszyfrowany (`sealed*`, klucz główny sekretów, AAD = firma nadawcy + id) tylko do wysyłki przez worker, potem
// jest czyszczony. Jak User i Invitation: RLS „nikt”, obsługa wyłącznie klientem systemowym.
model PasswordReset {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String // firma, której pocztą idzie link
  tokenHash      String    @unique
  sealedToken    Bytes?
  sealedIv       Bytes?
  sealedTag      Bytes?
  keyVersion     Int?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ═══: zapis na kanały (host zapisu, paczka) ═══════════════════════════════════════════════════
// Jeden wiersz = jeden zapis do kanału sprzedaży dla zamówienia: status (klucz mapy statusów konta, np. „WYSLANE”,
// „ANULOWANE_NIEOPLACONE”) albo numer nadania (klucz = numer). Unikalność (zamówienie, rodzaj, klucz) sprawia, że
// przejście „Wysłane” trafia do kanału raz, także przy podwójnym przebiegu workera. Konto w cieniu dostaje wiersz
// `mode = CIEN`, `state = CIEN` („wysłałbym”), bez wywołania kanału. Bez danych klientów.
enum ChannelWriteKind {
  STATUS
  NADANIE
}

enum ChannelWriteState {
  OCZEKUJE
  WYSYLANIE // zajęty przez przebieg workera (lockedAt); porzucony = NIEJEDNOZNACZNY
  WYSLANE
  CIEN // konto w cieniu: „wysłałbym”
  NIEJEDNOZNACZNY // nie wiadomo, czy kanał zapisał: alert, bez ponowienia (ponawia człowiek: „Wypchnij teraz”)
  BLAD // trwały błąd albo wyczerpane ponowienia: alert
}

model ChannelWrite {
  organizationId   String            @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String            @id @default(cuid())
  orderId          String
  channel          Channel
  channelAccountId String
  kind             ChannelWriteKind
  key              String // STATUS: klucz mapy statusów; NADANIE: numer nadania
  channelStatus    String? // STATUS: status kanału z mapy w chwili zaplanowania
  carrier          String? // NADANIE: przewoźnik
  trackingUrl      String? // NADANIE: adres śledzenia, gdy znany
  mode             ChannelMode
  state            ChannelWriteState @default(OCZEKUJE)
  reference        String // klucz idempotencji zapisu (deriveReference)
  attempts         Int               @default(0)
  nextAttemptAt    DateTime
  lockedAt         DateTime?
  lastError        String?
  result           String? // wynik kanału (np. „bez-zmian:completed”), bez danych klientów
  createdAt        DateTime
  doneAt           DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, orderId, kind, key])
  @@index([organizationId, state, nextAttemptAt])
  @@index([organizationId, channel, channelAccountId, createdAt])
}

// akcja masowa z listy zamówień (zmiana statusu, przesyłki, druk etykiet) na 50 i więcej zamówieniach idzie
// w tle (zadanie kolejki `zamowienia-masowo`). Wiersz niesie postęp i wynik per zamówienie (numer, ok/błąd, komunikat
// bez danych klienta), żeby panel pokazał raport po fakcie. Mniejsze akcje wykonują się od razu i nie zostawiają wiersza.
model OrderBulkAction {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  kind           String // STATUS | PRZESYLKI | ETYKIETY; PRZESYLKI_DRUK | PRZESYLKI_ANULUJ (orderIds = id przesyłek)
  params         Json         @default("{}") // np. { status, powod } albo { gabaryt, stanowisko }
  orderIds       String[]
  state          String       @default("CZEKA") // CZEKA | TRWA | GOTOWE | BLAD
  done           Int          @default(0)
  ok             Int          @default(0)
  failed         Int          @default(0)
  results        Json         @default("[]") // { id, nr, ok, komunikat }[]
  createdBy      String
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  finishedAt     DateTime?

  @@index([organizationId, createdBy, createdAt])
}

// koszyki do zbierania (1 zamówienie = 1 koszyk, jak koszyki A–J w asystencie zbierania BL). Firma definiuje
// nazwy (A, B, … albo własne); kod do skanera to „KOSZ-<nazwa>” (lib/koszyki/kod.ts). `orderId` = zamówienie w koszyku
// teraz (unikalne: zamówienie jest najwyżej w jednym koszyku); po „Spakowane” koszyk zwalnia się sam.
model PackBasket {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  name           String
  orderId        String?      @unique
  assignedAt     DateTime?
  assignedById   String?
  createdAt      DateTime     @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
}

// automatyczne akcje firmy (jak „Automatyczne akcje” w BaseLinkerze): zdarzenie → warunki → kroki akcji,
// w grupach z kolejnością. Warunki i kroki to dane (JSON) sprawdzane jednym modułem (lib/automaty/schemat.ts), żadnego
// kodu w regułach. Rdzeń zostaje stały: krok „ustaw status” idzie tylko dozwolonym przejściem (lib/automaty/wykonanie.ts).
model AutomationGroup {
  organizationId String           @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String           @id @default(cuid())
  name           String
  sortOrder      Int              @default(0)
  collapsed      Boolean          @default(false)
  /// klucz grupy z presetu firmy; null = grupa założona w panelu
  presetKey      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rules          AutomationRule[]

  @@unique([organizationId, presetKey])
  @@index([organizationId, sortOrder])
}

// Reguła: `event` = zdarzenie (lib/automaty/schemat.ts ZDARZENIA), `conditions` = lista warunków, `actions` =
// uporządkowana lista kroków. Przycisk = reguła ze zdarzeniem PRZYCISK (`buttonLabel`, `buttonPlaces`). `hidden` =
// usunięta reguła z historią wykonań (wyłączona i ukryta, historia na karcie zamówienia zostaje).
model AutomationRule {
  organizationId String           @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String           @id @default(cuid())
  groupId        String?
  group          AutomationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name           String
  sortOrder      Int              @default(0)
  enabled        Boolean          @default(false)
  event          String
  conditions     Json             @default("[]")
  actions        Json             @default("[]")
  buttonLabel    String?
  buttonPlaces   String[]         @default([])
  hidden         Boolean          @default(false)
  /// klucz reguły z presetu firmy: preset zakłada tylko brakujące klucze, nigdy nie nadpisuje reguły
  /// zmienionej albo usuniętej w panelu; null = reguła założona w panelu
  presetKey      String?
  /// opis dla zespołu, np. dlaczego reguła jest wyłączona; widoczny na liście reguł
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  runs           AutomationRun[]

  @@unique([organizationId, presetKey])
  @@index([organizationId, event, enabled])
}

// Wykonanie reguły na zamówieniu: jedno na (reguła, zamówienie, okazja) — idempotencja. `chain` = długość łańcucha
// „ustawiono status → ustaw status” (bezpiecznik pętli), `steps` = wynik kroków (bez danych klienta).
model AutomationRun {
  organizationId String         @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String         @id @default(cuid())
  ruleId         String
  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  occasion       String
  event          String
  chain          Int            @default(0)
  result         String
  steps          Json           @default("[]")
  createdAt      DateTime       @default(now())

  @@unique([organizationId, ruleId, orderId, occasion])
  @@index([organizationId, orderId, createdAt])
  @@index([organizationId, createdAt])
}

// Kursor przebiegu zdarzeń zamówień firmy (lib/automaty/silnik.ts `przetworzZdarzenia`): chwila ostatniego przetworzonego zdarzenia.
model AutomationCursor {
  organizationId String       @id @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lastAt         DateTime
  lastId         String       @default("")
  updatedAt      DateTime     @updatedAt
}

// archiwum zamówień sprzed odczytu kanału przez Kompletor (historia do raportów rok do roku). Osobne tabele,
// nie `Order`: żadne zapytanie operacyjne (pulpit pracy, lista, pakowanie, automaty, maile, API v1, cień, retencja)
// archiwum nie widzi; czytają je tylko raporty sprzedaży i wyszukiwanie (lista plików w tests/archiwum-straznik.test.ts).
// Bez danych klienta (etap 4 dołoży szyfrowane ArchivedOrderCustomer). Tylko do odczytu po imporcie, bez rezerwacji,
// ruchów magazynowych, faktur i zapisów do kanałów. Import: `npm run archiwum -- import` (lib/archiwum/).
model ArchivedOrder {
  organizationId   String              @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String              @id @default(cuid())
  /// skąd wiersz: WOO_API | ALLEGRO_API | ALLEGRO_ZRZUT | MIRAKL_API | EASYTOOLS_API | BL_FAKTURA
  source           String
  channel          Channel
  /// kanał odtworzony, nie podany przez źródło (faktura BL bez pary w pozostałych kanałach = Allegro); raport liczy normalnie, ale pokazuje osobno
  channelInferred  Boolean             @default(false)
  channelAccountId String
  externalId       String
  channelNumber    String? // numer widoczny w kanale, gdy inny niż id (Woo: numeracja wtyczki)
  blOrderId        Int?
  /// status końcowy w słowniku Kompletora: WYSLANE | ODEBRANE | ANULOWANE | REKLAMACJA; null = nie do ustalenia
  status           OrderStatus?
  channelStatus    String // surowy status kanału
  createdAtChannel DateTime
  closedAt         DateTime?
  paymentState     PaymentState
  paymentMethod    String?
  totalGross       Decimal             @db.Decimal(12, 2)
  shippingGross    Decimal?            @db.Decimal(12, 2)
  refundGross      Decimal             @default(0) @db.Decimal(12, 2)
  currency         String
  deliveryMethod   String?
  trackingNumbers  String[]
  invoiceNumbers   String[]
  sourceRevision   String?
  importRunId      String?
  importedAt       DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lines ArchivedOrderLine[]

  @@unique([organizationId, channel, channelAccountId, externalId])
  @@index([organizationId, createdAtChannel])
  @@index([organizationId, blOrderId])
}

model ArchivedOrderLine {
  organizationId String        @default(dbgenerated("current_setting('app.org_id'::text)"))
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String        @id @default(cuid())
  orderId        String
  externalLineId String
  offerId        String?
  productId      String? // produkt z katalogu, gdy dało się zmapować (oferta, SKU, EAN); null = poza marżą
  name           String
  sku            String?
  ean            String?
  /// ilość w jednostce bazowej produktu (oferta × przelicznik), bez pozycji wysyłki
  qty            Decimal       @db.Decimal(12, 3)
  /// wartość pozycji brutto (po rabacie), cała pozycja, nie za sztukę
  lineGross      Decimal       @db.Decimal(12, 2)
  vatRate        String?
  refundQty      Decimal       @default(0) @db.Decimal(12, 3)
  refundGross    Decimal       @default(0) @db.Decimal(12, 2)

  order ArchivedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, externalLineId])
  @@index([organizationId, productId])
}
