# Kompletor: nazwy zmiennych. Wartości tylko w .env (poza repo), na produkcji w Coolify.
# Lokalna baza z docker-compose (port 55433). Hasło lokalne z docker-compose.dev.yml.
DATABASE_URL=postgresql://logistyka:<haslo-lokalne>@127.0.0.1:55433/logistyka
# klient firmy loguje się własną rolą LOGIN logistyka_app (README „Rola aplikacji”). Hasło ustawia
# `npm run rola:aplikacji` (po migracjach). Lokalnie hasło logistyka_app_local, to samo przyjmują testy (rola jest
# wspólna dla całego serwera Postgres). Puste = stary tryb (właściciel z -c role=, tylko self-host, z ostrzeżeniem).
APP_DATABASE_URL=postgresql://logistyka_app:logistyka_app_local@127.0.0.1:55433/logistyka
SHADOW_DATABASE_URL=postgresql://logistyka:<haslo-lokalne>@127.0.0.1:55433/logistyka_shadow
# Testy integracyjne: osobna baza (czyszczona przez testy). Musi kończyć się na _test.
TEST_DATABASE_URL=postgresql://logistyka:<haslo-lokalne>@127.0.0.1:55433/logistyka_test
# Rola aplikacji w testach (opcjonalnie; puste = adres TEST_DATABASE_URL z logistyka_app:logistyka_app_local).
TEST_APP_DATABASE_URL=

# jedna firma (self-host) albo wiele (hosting). README: „Jedna firma (self-host) vs wiele firm (hosting)”.
# self-host (domyślnie): klucze poniżej z env działają dla jedynej firmy w bazie (albo wskazanej SELFHOST_ORG_SLUG).
# hosted: klucze wyłącznie jako sekrety firmy w bazie (npm run sekret), env poniżej nie jest kluczem żadnej firmy.
APP_MODE=self-host
SELFHOST_ORG_SLUG=
# adres panelu do linków w zaproszeniach (hosting), np. https://panel.example.com — bez ścieżki zaproszenia.
# Nigdy z nagłówka Host żądania. W hostingu bez tej zmiennej zaproszenia dają czytelną odmowę.
PANEL_URL=
# serwer MCP (/api/mcp) — adres dla agentów AI to PANEL_URL + /api/mcp. Originy przeglądarki (po przecinku), które
# mogą wołać serwer MCP oprócz originu PANEL_URL; puste = tylko PANEL_URL. Klienci CLI i serwerowi nie wysyłają Origin.
MCP_DOZWOLONE_ORIGINY=
# Klucz główny szyfrowania sekretów firm (AES-256-GCM, 32 bajty): openssl rand -hex 32. Poza bazą i jej backupem.
APP_ENCRYPTION_KEY=
# Rotacja (README „Rotacja klucza głównego”): wersje najnowsza pierwsza, np. 2:<hex>,1:<hex>. Zapis kluczem
# najnowszym, odczyt kluczem wersji wpisu. Obok może zostać APP_ENCRYPTION_KEY tylko równy wersji 1.
APP_ENCRYPTION_KEYS=
# dane klienta w zamówieniu (docs/dane-klienta.md). Klucz szyfrowania danych klientów — OSOBNY od
# APP_ENCRYPTION_KEYS (wyciek jednego nie odsłania drugiego), poza bazą i jej kopią: „<wersja>:<klucz>,…”, najnowsza
# pierwsza, klucz = openssl rand -hex 32, np. 1:<64 znaki hex>. Rotacja: dopisz 2:<nowy> na początku, uruchom
# `npm run klienci -- przeszyfruj --wszystkie-firmy`, potem usuń starą wersję. Brak = zapis odmawia, panel pokazuje
# „Dane klienta niedostępne: brak klucza szyfrowania”, reszta systemu działa. Web i worker muszą mieć ten sam.
CUSTOMER_DATA_KEYS=
# Klucz HMAC skrótów do wyszukiwania po e-mailu i telefonie (32 bajty: openssl rand -hex 32). Bez niego zapis odmawia.
# Zmiana = `npm run klienci -- przeszyfruj --wszystkie-firmy --skroty` (przeliczenie skrótów z odszyfrowanych danych; uzupełnia też jawny kod kraju dostawy u starszych zamówień).
CUSTOMER_LOOKUP_KEY=
# 1 = instancja zapisuje dane klienta w bazie (zadanie po przyjęciu zamówienia, „Odśwież z kanału”); puste/0 = nie.
# Konto kanału w cieniu zapisuje tylko, gdy firma włączy „zapis w cieniu” (Ustawienia → Dane klientów).
DANE_KLIENTA_ZAPIS=
# AI (lib/ai.ts): self-host: klucz klienta; hosting: nasz klucz, rozliczany z salda firmy (gdy firma nie poda własnego).
AI_API_KEY=
PLATFORM_AI_API_KEY=
# Packshot AI (Kie.ai): self-host KIE_API_KEY, hosting PLATFORM_KIE_API_KEY (z salda firmy).
KIE_API_KEY=
PLATFORM_KIE_API_KEY=
# Bezpiecznik kluczy platformy: najwyżej tyle groszy AI na firmę w 24 h (puste = 2000, czyli 20 zł; 0 = AI z kluczy
# platformy wyłączone). Własny klucz firmy limitu nie ma.
PLATFORM_AI_LIMIT_DZIENNY_GROSZE=
# Asystent „Zapytaj”: najwyżej tyle odpowiedzi z AI na firmę w 24 h (puste = 500; 0 = tylko „nie wiem”).
ASYSTENT_PYTANIA_FIRMY_NA_DOBE=

# Klucze integracji (self-host z env). Te same nazwy mają sekrety firmy w bazie.

# BaseLinker (tylko odczyt get* do przełączenia)
BASELINKER_TOKEN=
# Inventory BL i magazyn wFirmy: konfiguracja firmy w bazie (Organization.settings, Warehouse), nie env.

# Klucze kont kanałów z env (self-host, tylko jedyna firma): nazwy zmiennych mają przedrostek ustawiony w
# `config.envPrefix` konta kanału (preset firmy albo panel), np. konto Woo z envPrefix „SKLEP1_WC” czyta poniższe.
# Każdy sklep Woo ma swój przedrostek (SKLEP2_WC_URL/KEY/SECRET itd.). W cieniu tylko GET.
SKLEP1_WC_URL=
SKLEP1_WC_KEY=
SKLEP1_WC_SECRET=
# Allegro: Client ID i Secret istniejącej aplikacji firmy jako <envPrefix>_CLIENT_ID / _CLIENT_SECRET konta
# (np. envPrefix „ALLEGRO1”: ALLEGRO1_CLIENT_ID=). Tokeny NIGDY w env: własną parę Kompletora zapisuje w sekretach
# konta `npm run cien -- allegro-autoryzuj [--konto <id>]` (device flow), a adapter ją rotuje.

# Empik / Mirakl (istniejący klucz, NIE generować nowego)
EMPIK_MIRAKL_BASE_URL=https://empik-prod.mirakl.net/api
EMPIK_MIRAKL_API_KEY=

# Base Courier / dawna BL Paczka
BASECOURIER_LOGIN=
BASECOURIER_API_KEY=

# DPD x2 (konto „DPD” i „DPD Salony Empik”): zapas, faza 1 idzie przez Base Courier
DPD_LOGIN=
DPD_PASSWORD=
DPD_FID=
DPD_EMPIK_LOGIN=
DPD_EMPIK_PASSWORD=
DPD_EMPIK_FID=

# wFirma API2
WFIRMA_ACCESS_KEY=
WFIRMA_SECRET_KEY=
WFIRMA_APP_KEY=
WFIRMA_COMPANY_ID=

# katalog zdjęć produktów (podkatalog na firmę; usunięte zdjęcia idą do old/). Puste = .dane/zdjecia w katalogu
# aplikacji. W obrazie Dockera /dane/zdjecia (wolumen `zdjecia` w compose.yaml) — razem z bazą do kopii zapasowej.
ZDJECIA_DIR=

# Worker
WORKER_POLL_MS=2000

# Import katalogu: jeden plik nadpisań powiązań ofert dla każdej firmy (zwykle puste: plik firmy to
# dane/nadpisania-ofert/<id firmy>.csv albo prywatne/nadpisania-ofert/<id firmy>.csv) i katalog raportów workera
NADPISANIA_OFERT=
RAPORTY_DIR=
# katalog plików nadpisań firm (<id firmy>.csv), np. zamontowany do kontenera; puste = jak wyżej
KOMPLETOR_NADPISANIA_KATALOG=

# Panel: ciasteczko sesji Secure w produkcji; false tylko do testu produkcyjnego builda po http://
COOKIE_SECURE=

# obraz Dockera (README „Obraz Dockera i deploy (Coolify)”).
# Rola kontenera: web (panel, domyślnie) albo worker. Seed firmy przy starcie roli web (idempotentny): nazwa presetu
# z seed/presety/<nazwa>.json albo z prywatnej nakładki prywatne/presety/<nazwa>.json (poza repo, w kontenerze
# zamontowana do /app/prywatne/presety), `demo` (firma z danymi fikcyjnymi) albo puste.
KOMPLETOR_ROLA=web
KOMPLETOR_SEED=
# Własny plik presetu (np. zamontowany do kontenera); wygrywa z nazwą z KOMPLETOR_SEED.
KOMPLETOR_PRESET_PLIK=
# `docker compose up` (compose.yaml): katalog wolumenu sekretów. Entrypoint buduje z niego DATABASE_URL,
# APP_DATABASE_URL i APP_ENCRYPTION_KEY, gdy nie są ustawione wyżej; kreator /start czyta z niego kod instalacji.
KOMPLETOR_SEKRETY_DIR=
# Kod kreatora /start bez wolumenu sekretów (instalacja na własnej platformie). Puste = kreator zamknięty.
KOMPLETOR_KOD_INSTALACJI=
# Tylko compose.yaml: port panelu na 127.0.0.1, ciasteczko Secure (true za HTTPS), nazwa obrazu.
KOMPLETOR_PORT=
KOMPLETOR_COOKIE_SECURE=
KOMPLETOR_OBRAZ=
# Bramka Basic Auth na panel (proxy.ts, przed sesją panelu). Oba albo żadne (jedno = panel zamknięty, 503).
# W NODE_ENV=production (obraz, `next start`) brak obu = też 503, chyba że BASIC_AUTH_DISABLED=1
# (self-host za własnym proxy albo instancja z samym logowaniem). Bramkę wyłącza się tą zmienną.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
BASIC_AUTH_DISABLED=
# Token operatora do pełnej odpowiedzi /api/health w APP_MODE=hosted (nagłówek `Authorization: Bearer <token>`,
# np. `openssl rand -hex 32`). Puste = w hostingu bez autoryzacji tylko stan, commit i migracje.
HEALTH_TOKEN=
# Import katalogu w workerze co N godzin (puste = wyłączony).
KATALOG_IMPORT_CO_GODZIN=
# SUFIT okna sprzedaży importu (worker i CLI `import:katalog --dni`): puste/0 = bez odczytu zamówień BL (bez danych
# klientów). Zadanie z większym salesDays zostaje przycięte, `--dni` ponad sufit = błąd. Lokalnie np. 90.
KATALOG_IMPORT_DNI_SPRZEDAZY=0
# Plik życia workera dla healthchecku kontenera (w obrazie ustawiony; lokalnie puste = wyłączony).
WORKER_HEARTBEAT_FILE=
# 1 = worker loguje też każde udane zadanie rdzenia z harmonogramu (diagnoza; domyślnie puste = ciszej).
WORKER_LOG_DONE=
# Cień zamówień: okno pierwszego odczytu kont i porównania z BL, w godzinach (domyślnie 24)
CIEN_OKNO_GODZINY=24
# Wyłącznik cienia zamówień: 1/puste = włączony (domyślnie), 0 = worker nie czyta zamówień z kanałów
# ani nie porównuje z BL (dane osobowe), także zadań już w kolejce. Na serwerze 0, dopóki właściciel nie ma konta w panelu.
# Dotyczy tylko zadań cienia workera: okno sprzedaży importu katalogu (getOrders z BL) to osobny wyłącznik
# KATALOG_IMPORT_DNI_SPRZEDAZY, a ręczne `npm run cien -- test|raport --porownaj` to świadome polecenie operatora.
CIEN_ODCZYT=
# Lustro stanów wFirmy w cieniu (zadanie rdzen-wfirma co 2 min): 1 = włączone, 0 = wyłączone (zero wywołań
# wFirmy z kolejki, także zadań już w kolejce), puste = jak CIEN_ODCZYT. Tylko odczyt goods/find (bez danych klientów),
# ale tym samym kluczem API, którym BL wystawia faktury: budżet 20 wywołań na przebieg, limit wFirmy wstrzymuje kolejkę.
CIEN_LUSTRO_WFIRMY=
DANE_ODBIORCY_Z_KANALU=
# ekrany trybu PRACA na karcie zamówienia (sekcja „Co dalej”, docs/tryb-praca.md). 1 = włączone na tej
# instancji, 0/puste = wyłączone (domyślnie). Działają tylko dla kont kanałów w trybie PRACA (Ustawienia → Kanały).
# Zła wartość = błąd. Przyciski zmieniają tylko status w Kompletorze: nic nie idzie do kanału, wFirmy ani kuriera.
EKRANY_PRACA=

# link do paczki agenta druku (Kompletor-Druk-<wersja>-win-x64.zip) pokazywany w Ustawienia → Druk.
# Puste = zamiast linku instrukcja z docs/druk.md („Paczka programu”). Np. adres pliku w magazynie plików firmy.
# Ustawiony ma pierwszeństwo przed AGENT_DRUKU_KATALOG.
AGENT_DRUKU_URL=
# Katalog na serwerze aplikacji (trwały wolumen) z paczką Kompletor-Druk-<wersja>-win-x64.zip. Aplikacja serwuje ją
# zalogowanym z uprawnieniem „Ustawienia firmy” pod /api/wydruki/program (przycisk „Pobierz program (Windows)”).
# Liczą się tylko pliki według tego wzoru nazwy, przy kilku najwyższa wersja. Puste albo bez pliku = brak przycisku.
AGENT_DRUKU_KATALOG=

# alerty na Zulip (docs/powiadomienia.md). Wysyłka wymaga OBU bramek: tej zmiennej instancji i włącznika
# firmy w Ustawieniach → Powiadomienia. 1 = instancja może wysyłać, 0/puste = nie (domyślnie). Zła wartość = worker
# nie startuje. Klucz bota to sekret firmy ZULIP_API_KEY (npm run sekret), nigdy w env.
POWIADOMIENIA_WYSYLKA=
# Dozwolone hosty Zulipa (po przecinku, nazwa albo *.domena); puste = *.zulipchat.com. Dla Zulipa na własnym serwerze.
ZULIP_DOZWOLONE_HOSTY=

# maile do klientów i biura (docs/poczta.md). Wysyłka wymaga OBU bramek: tej zmiennej instancji i włącznika
# firmy w Ustawieniach → Poczta; mail z planu akcji wychodzi tylko dla kont kanałów w trybie PRACA. 1 = instancja może
# wysyłać, 0/puste = nie (domyślnie). Zła wartość = błąd zadania. Hasło SMTP to sekret firmy SMTP_PASSWORD (panel), nigdy
# w env. Link resetu hasła i przyciski w mailach do biura biorą adres z PANEL_URL (bez niego link resetu nie powstaje).
POCZTA_WYSYLKA=
# poczta serwera (instalacji) TYLKO do linków „Nie pamiętam hasła” (docs/poczta.md, „Reset hasła”). Ustawia operator
# serwera; poczta firmy z panelu nigdy nie wysyła linków resetu (konto jest wspólne dla instalacji). Puste
# RESET_SMTP_HOST = reset mailem wyłączony. SZYFROWANIE: STARTTLS (domyślnie), TLS albo BRAK (BRAK nie w hostingu).
RESET_SMTP_HOST=
RESET_SMTP_PORT=
RESET_SMTP_SZYFROWANIE=
RESET_SMTP_LOGIN=
RESET_SMTP_PASSWORD=
RESET_SMTP_NADAWCA=
RESET_SMTP_NAZWA=
# Opcjonalny publiczny adres panelu (np. https://kompletor.firma.pl) do linku w wiadomościach; puste = bez linku.
APP_PUBLIC_URL=

# produkcyjny KSeF dla firm z programem „KSeF bezpośrednio” (lib/ksef/api/bramka.ts). Ustawia wyłącznie
# operator serwera. Bez obu zmiennych faktury idą tylko do KSeF TEST/DEMO, nawet gdy firma wybierze „produkcyjne”.
# KSEF_PROD_NIPS: NIP-y firm z otwartą produkcją (po przecinku); pusta lista = produkcja zamknięta dla wszystkich.
KSEF_PROD_ENABLED=
KSEF_PROD_NIPS=
