  "automationRules": [
    {
      "key": "oplacone-do-realizacji",
      "groupKey": "przyjecie",
      "name": "Opłacono → Do realizacji",
      "event": "OPLACONO",
      "conditions": [],
      "actions": [
        {
          "typ": "ustawStatus",
          "status": "DO_REALIZACJI"
        }
      ]
    },
    {
      "key": "pobranie-do-realizacji",
      "groupKey": "przyjecie",
      "name": "Nowe za pobraniem → Do realizacji",
      "event": "POBRANO",
      "conditions": [
        {
          "typ": "pobranie",
          "wartosc": true
        }
      ],
      "actions": [
        {
          "typ": "ustawStatus",
          "status": "DO_REALIZACJI"
        }
      ]
    },
    {
      "key": "przesylka-do-wyslania",
      "groupKey": "wysylka",
      "name": "Utworzono przesyłkę → Do wysłania i etykieta",
      "event": "UTWORZONO_PRZESYLKE",
      "conditions": [
        {
          "typ": "status",
          "wartosci": [
            "SPAKOWANE"
          ]
        }
      ],
      "actions": [
        {
          "typ": "ustawStatus",
          "status": "DO_WYSLANIA"
        },
        {
          "typ": "drukujEtykiete",
          "stanowisko": null
        }
      ]
    },
    {
      "key": "kurier-odebral-wyslane",
      "groupKey": "wysylka",
      "name": "Kurier odebrał paczkę → Wysłane",
      "event": "STATUS_PRZESYLKI",
      "conditions": [
        {
          "typ": "statusPrzesylki",
          "frazy": [
            "taken_by_courier",
            "collected_from_sender",
            "adopted_at_source_branch",
            "sent_from_source_branch",
            "odebrana przez kuriera",
            "nadana",
            "w drodze"
          ]
        },
        {
          "typ": "status",
          "wartosci": [
            "DO_WYSLANIA"
          ]
        }
      ],
      "actions": [
        {
          "typ": "ustawStatus",
          "status": "WYSLANE"
        }
      ]
    },
    {
      "key": "przypomnienie-o-platnosci",
      "groupKey": "platnosci",
      "name": "Brak płatności 2 dni robocze → przypomnienie e-mailem",
      "event": "W_STATUSIE_DNI",
      "conditions": [
        {
          "typ": "dniWStatusie",
          "dni": 2,
          "robocze": true
        },
        {
          "typ": "status",
          "wartosci": [
            "NOWE"
          ]
        }
      ],
      "actions": [
        {
          "typ": "wyslijEmail",
          "szablon": "brak-platnosci"
        }
      ]
    },
    {
      "key": "anuluj-bez-platnosci",
      "groupKey": "platnosci",
      "name": "Brak płatności 5 dni roboczych → anuluj",
      "event": "W_STATUSIE_DNI",
      "conditions": [
        {
          "typ": "dniWStatusie",
          "dni": 5,
          "robocze": true
        },
        {
          "typ": "status",
          "wartosci": [
            "NOWE"
          ]
        },
        {
          "typ": "pobranie",
          "wartosc": false
        }
      ],
      "actions": [
        {
          "typ": "anulujZamowienie"
        }
      ]
    }
  ]
}
